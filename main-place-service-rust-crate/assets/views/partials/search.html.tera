{# HTMX partial: returns just the inner HTML for the #search-results container. #}
{% if query | length == 0 %}
  <p><span class="hint" aria-label="Empty query">Enter a query above to search {{ entity_plural }}.</span></p>
{% elif results | length == 0 %}
  <div class="alert" role="alert" aria-label="No results" data-type="info">
    No {{ entity_plural }} match &ldquo;{{ query }}&rdquo;.
  </div>
{% else %}
  <p><span class="hint" aria-label="Result count">{{ results | length }} match{% if results | length != 1 %}es{% endif %} for &ldquo;{{ query }}&rdquo;:</span></p>
  <ul aria-label="Search results">
    {% for r in results %}
      <li>
        <a href="/{{ entity_plural }}/{{ r.id }}">{{ r.label }}</a>
        {% if r.subtitle %}<br><span class="hint" aria-label="Subtitle">{{ r.subtitle }}</span>{% endif %}
      </li>
    {% endfor %}
  </ul>
{% endif %}
