# Server-side BFF config only — read in src/lib/server/config.ts and never
# exposed to the client bundle. The browser calls the same-origin proxy at
# /api/proxy; there is no public API base URL (see src/lib/config.ts).

# Course Service REST API base URL (no trailing slash). course-service-with-loco
# is the one service in the family whose dev config overrides the loco default
# to port 8084 (see course-service-with-loco/config/development.yaml) so it
# doesn't clash with person-service on 8080. src/lib/server/config.ts's own
# fallback (used only if this var is unset) matches this default as of T-28
# (2026-08-29); setting this var explicitly is still recommended.
COURSE_API_URL=http://localhost:8084

# Authentication Service base URL — session -> PASETO exchange + magic-link
# login. authentication-service-with-loco uses the family's loco default,
# port 5150.
AUTH_API_URL=http://localhost:5150
