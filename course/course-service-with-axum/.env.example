# Course Service — Environment Configuration Example
# Copy this to .env and update with local values.

# Database — match the docker-compose POSTGRES_* defaults.
DATABASE_URL=postgresql://course_user:course_password@localhost:5434/course
DATABASE_MAX_CONNECTIONS=10
DATABASE_MIN_CONNECTIONS=2

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
GRPC_PORT=50054

# Search index (Tantivy)
SEARCH_INDEX_PATH=./data/search_index

# Matching threshold (probabilistic). 0.85 is the default per spec §6.
MATCHING_THRESHOLD=0.85

# Observability
RUST_LOG=info,sqlx=warn
OTLP_SERVICE_NAME=course-service
OTLP_ENDPOINT=http://localhost:4317

# Durable event bus (agents/share/event-bus.md).
# COURSE_EVENT_TRANSPORT: `memory` (default) = in-memory publish only, no DB
# writes; `outbox` = additionally write one `course_outbox` row inside each
# Course write's transaction (Phase 2). Unset/unrecognised ⇒ `memory`.
COURSE_EVENT_TRANSPORT=memory
# COURSE_EVENT_RELAY: Phase-3 relay worker toggle. Truthy (1/true/yes/on)
# spawns the background loop that drains unpublished `course_outbox` rows to
# the sink (default LoggingSink), stamps `published_at`, and purges old
# published rows. Only runs when COURSE_EVENT_TRANSPORT=outbox. Off by default.
COURSE_EVENT_RELAY=false
# COURSE_EVENT_RELAY_INTERVAL_SECS: relay poll interval in seconds
# (default 5, floored at 1).
COURSE_EVENT_RELAY_INTERVAL_SECS=5
# COURSE_EVENT_RETENTION_DAYS: outbox row TTL enforced by the Phase-3 relay's
# retention sweep (published rows older than this are purged). Default 7.
COURSE_EVENT_RETENTION_DAYS=7
