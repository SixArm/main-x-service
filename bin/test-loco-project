#!/bin/sh
set -euf

## https://github.com/sixarm/unix-shell-script-kit

err() { >&2 printf %s\\n "Error: ${*}"; }

directory_exists_or_err() { test -d "$1" || err "Directory should exist: $1"; }
file_exists_or_err() { test -f "$1" || err "File should exist: $1"; }
file_size_or_err() { file_exists_or_err "$1" && test -s "$1" || err "File should have size: $1"; }
symlink_exists_or_err() { test -h "$1" || err "Symlink should exist: $1"; }
grep_exists_or_err() { grep -q -m 1 "$@" || err "grep should exist: " "$@"; }
task_exists_or_err() { grep -q -m 1 "^- \[" "$1" || err "task should exist: " "$1"; }
implemented_or_err() { if (grep -q -m 1 "Not yet implemented\." "$1"); then err "not yet implemented: $1"; else true; fi; }

### Utilities

ai_exists_or_err() (
    # dir="$1" — the spec-driven-development convention is to keep
    # implementation plan and task list together in a single spec.md
    # per directory; older plan.md / tasks.md splits have been merged.
    directory_exists_or_err "$1"
    file_size_or_err "$1/index.md"
    symlink_exists_or_err "$1/README.md"
    file_size_or_err "$1/AGENTS.md" && implemented_or_err "$1/AGENTS.md"
    file_size_or_err "$1/CLAUDE.md"
    file_size_or_err "$1/spec/index.md" && implemented_or_err "$1/spec/index.md"
)

### Main
test_loco_project() {
    # dir="$1"
    ai_exists_or_err "$1"
    echo "$1"
    # Loco service crates put the binary entry at src/bin/main.rs; older
    # template crates use src/main.rs. Resolve whichever exists.
    main_rs="$1/src/main.rs"
    test -f "$main_rs" || main_rs="$1/src/bin/main.rs"
    for file in "$main_rs" "$1/src/lib.rs"; do
        file_exists_or_err "$file"
        grep_exists_or_err "#!\[warn(clippy::pedantic)\]" "$file"
        grep_exists_or_err "#!\[forbid(unsafe_code)\]" "$file"
        grep_exists_or_err "#!\[deny(missing_docs)\]" "$file"
    done
    file="$main_rs"
    grep_exists_or_err "#\[cfg(target_env = \"musl\")\]" "$file"
    grep_exists_or_err "#\[global_allocator\]" "$file"
    grep_exists_or_err "static GLOBAL: mimalloc::MiMalloc = mimalloc::MiMalloc;" "$file"
    cd "$1"
    cargo update
    cargo check --all-targets
    cargo clippy
    cargo test
    cargo build --workspace 
    # cargo build --target x86_64-unknown-linux-musl
    # cargo bench
    # cargo report future-incompatibilities
}

test_loco_project "$1"
