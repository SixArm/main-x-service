# BFF server-side config (src/lib/server/config.ts). Never exposed to the
# browser bundle — the browser only ever calls the same-origin /api/proxy.

# Worker Service REST API base URL (no trailing slash).
WORKER_API_URL=http://localhost:5150

# Authentication Service base URL — magic-link login + session->PASETO
# exchange (no trailing slash).
AUTH_API_URL=http://localhost:5150

# Opt-in "Sign in with SSO" link (OIDC / Keycloak via the auth service,
# agents/share/authentication-sessions.md §7a). A plain boolean flag, not
# an API base URL. Set ONLY when the paired auth-service deployment has
# its own AUTH_OIDC_* variables configured; unset (the default) hides the
# link and makes /signin/sso 404 — magic link stays the default.
# PUBLIC_OIDC_SIGNIN_ENABLED=true
