# BFF server-side config (src/lib/server/config.ts). Never exposed to the
# browser bundle — the browser only ever calls the same-origin /api/proxy.

# Worker Service REST API base URL (no trailing slash).
WORKER_API_URL=http://localhost:5150

# Authentication Service base URL — magic-link login + session->PASETO
# exchange (no trailing slash).
AUTH_API_URL=http://localhost:5150
