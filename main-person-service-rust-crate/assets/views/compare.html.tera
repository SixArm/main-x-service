{% extends "layout.html.tera" %}

{% block title %}Compare {{ entity_plural }} &mdash; {{ app_display }}{% endblock title %}

{% block content %}
<nav class="breadcrumb-nav" aria-label="Breadcrumb">
  <ol class="breadcrumb-list" aria-label="Breadcrumb trail">
    <li class="breadcrumb-list-item"><a href="/">Home</a></li>
    <li class="breadcrumb-list-item"><a href="/{{ entity_plural }}">{{ entity_plural | capitalize }}</a></li>
    <li class="breadcrumb-list-item"><a href="/{{ entity_plural }}/review-queue">Review queue</a></li>
    <li class="breadcrumb-list-item" aria-current="page">Compare</li>
  </ol>
</nav>

<section aria-label="Match comparison">
  <h2>Compare {{ entity_plural }}</h2>
  <p>
    <span class="hint" aria-label="Comparison summary">
      Side-by-side comparison of two candidate {{ entity_plural }}. Review the
      per-component scores below before confirming a merge.
    </span>
  </p>

  <div class="card" role="region" aria-label="Overall match score">
    <h3>Overall match</h3>
    <p>
      <meter class="meter"
             aria-label="Overall match score {{ overall.score_pct }} percent"
             min="0"
             max="100"
             low="50"
             high="85"
             optimum="100"
             value="{{ overall.score_pct }}">{{ overall.score_pct }}%</meter>
      <strong>{{ overall.score }}</strong>
      {% if overall.quality == "definite" %}
        <span class="badge" data-type="success" aria-label="Definite match">Definite</span>
      {% elif overall.quality == "probable" %}
        <span class="badge" data-type="warning" aria-label="Probable match">Probable</span>
      {% elif overall.quality == "possible" %}
        <span class="badge" data-type="info" aria-label="Possible match">Possible</span>
      {% else %}
        <span class="badge" data-type="error" aria-label="Unlikely match">Unlikely</span>
      {% endif %}
    </p>
    <p>
      <span class="hint" aria-label="Detection method">Detected via {{ overall.detection_method }}</span>
    </p>
  </div>

  <div class="diff" role="group" aria-label="Side-by-side comparison">
    <article class="card" role="region" aria-label="Candidate A: {{ a.label }}">
      <header>
        <h3>
          <a href="/{{ entity_plural }}/{{ a.id }}">{{ a.label }}</a>
        </h3>
        <p>
          <span class="hint" aria-label="Candidate role">Candidate A &middot; would survive as the main record</span>
        </p>
      </header>
      <ol class="summary-list" aria-label="Candidate A fields">
        {% for f in fields %}
          <li class="summary-list-item">
            <dl>
              <dt>{{ f.label }}</dt>
              <dd>{{ f.a_value | default(value="—") }}</dd>
            </dl>
          </li>
        {% endfor %}
      </ol>
    </article>

    <article class="card" role="region" aria-label="Candidate B: {{ b.label }}">
      <header>
        <h3>
          <a href="/{{ entity_plural }}/{{ b.id }}">{{ b.label }}</a>
        </h3>
        <p>
          <span class="hint" aria-label="Candidate role">Candidate B &middot; would soft-delete on merge</span>
        </p>
      </header>
      <ol class="summary-list" aria-label="Candidate B fields">
        {% for f in fields %}
          <li class="summary-list-item">
            <dl>
              <dt>{{ f.label }}</dt>
              <dd>{{ f.b_value | default(value="—") }}</dd>
            </dl>
          </li>
        {% endfor %}
      </ol>
    </article>
  </div>

  <h3>Per-component scores</h3>
  <table class="data-table" aria-label="Per-component match scores">
    <thead class="data-table-head">
      <tr class="data-table-row">
        <th class="data-table-th" scope="col">Component</th>
        <th class="data-table-th" scope="col">A value</th>
        <th class="data-table-th" scope="col">B value</th>
        <th class="data-table-th" scope="col">Score</th>
        <th class="data-table-th" scope="col">Outcome</th>
      </tr>
    </thead>
    <tbody class="data-table-body">
      {% for f in fields %}
        <tr class="data-table-row">
          <td class="data-table-td">{{ f.label }}</td>
          <td class="data-table-td">{{ f.a_value | default(value="—") }}</td>
          <td class="data-table-td">{{ f.b_value | default(value="—") }}</td>
          <td class="data-table-td">
            <meter class="meter"
                   aria-label="{{ f.label }} score {{ f.score_pct }} percent"
                   min="0"
                   max="100"
                   low="50"
                   high="85"
                   optimum="100"
                   value="{{ f.score_pct }}">{{ f.score_pct }}%</meter>
            <span>{{ f.score }}</span>
          </td>
          <td class="data-table-td">
            {% if f.outcome == "match" %}
              <span class="badge" data-type="success" aria-label="Match">Match</span>
            {% elif f.outcome == "close" %}
              <span class="badge" data-type="warning" aria-label="Close">Close</span>
            {% elif f.outcome == "differ" %}
              <span class="badge" data-type="error" aria-label="Differ">Differ</span>
            {% else %}
              <span class="badge" aria-label="{{ f.outcome }}">{{ f.outcome }}</span>
            {% endif %}
          </td>
        </tr>
      {% endfor %}
    </tbody>
  </table>

  <div class="action-bar" role="toolbar" aria-label="Merge decision">
    <button class="button"
            type="button"
            aria-label="Open merge confirmation"
            onclick="document.getElementById('compare-merge').showModal()">
      Merge B into A
    </button>
    <button class="action-bar-button"
            type="button"
            aria-label="Reject as not a duplicate"
            hx-post="/api/{{ entity_plural }}/review-queue/{{ review_id }}/reject"
            hx-target="body"
            hx-push-url="/{{ entity_plural }}/review-queue"
            onclick="lily.toast('Marked as not a duplicate', 'info')">
      Not a duplicate
    </button>
    <a class="button"
       href="/{{ entity_plural }}/review-queue"
       aria-label="Back to review queue">Back to queue</a>
  </div>

  <dialog id="compare-merge"
          class="alert-dialog"
          role="alertdialog"
          aria-modal="true"
          aria-labelledby="compare-merge-title"
          aria-describedby="compare-merge-body">
    <h2 id="compare-merge-title">Merge B into A?</h2>
    <p id="compare-merge-body">
      This will merge <strong>{{ b.label }}</strong> into <strong>{{ a.label }}</strong>.
      Identifiers, names, addresses, contacts, documents, and emergency contacts
      transfer to A. B is soft-deleted and a {{ entity_singular }}-link
      (<em>Replaces</em>) is added from A. This action is reversible from the
      audit log.
    </p>
    <form method="dialog" class="form" aria-label="Confirm compare merge">
      <button class="button" type="submit" value="cancel" aria-label="Cancel merge">Cancel</button>
      <button class="button"
              type="submit"
              value="confirm"
              aria-label="Confirm merge"
              hx-post="/api/{{ entity_plural }}/merge"
              hx-vals='{"main_id": "{{ a.id }}", "duplicate_id": "{{ b.id }}", "review_id": "{{ review_id }}"}'
              hx-target="body"
              hx-push-url="/{{ entity_plural }}/{{ a.id }}"
              onclick="lily.toast('Merge completed', 'success')">Merge</button>
    </form>
  </dialog>
</section>
{% endblock content %}
