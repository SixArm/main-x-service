{% extends "layout.html.tera" %}

{% block title %}Search {{ entity_plural }} &mdash; {{ app_display }}{% endblock title %}

{% block content %}
<nav class="breadcrumb-nav" aria-label="Breadcrumb">
  <ol class="breadcrumb-list" aria-label="Breadcrumb trail">
    <li class="breadcrumb-list-item"><a href="/">Home</a></li>
    <li class="breadcrumb-list-item"><a href="/{{ entity_plural }}">{{ entity_plural | capitalize }}</a></li>
    <li class="breadcrumb-list-item" aria-current="page">Search</li>
  </ol>
</nav>

<section aria-label="Search {{ entity_plural }}">
  <h2>Search {{ entity_plural }}</h2>

  <div x-data="{ drawerOpen: false }">
    <form class="form"
          aria-label="{{ entity_plural | capitalize }} search"
          method="get"
          action="/{{ entity_plural }}/search">
      <div class="field" aria-label="Search query field">
        <label class="label" for="q">Query</label>
        <span class="hint" id="q-hint">Full-text search across name, identifiers, addresses, and contacts.</span>
        <input class="search-input"
               role="searchbox"
               type="search"
               id="q"
               name="q"
               value="{{ query | default(value='') }}"
               aria-label="Search {{ entity_plural }}"
               aria-describedby="q-hint"
               autocomplete="off"
               autofocus>
      </div>

      <div class="action-bar" role="toolbar" aria-label="Search actions">
        <button class="button" type="submit" aria-label="Run search">Search</button>
        <a class="button" href="/{{ entity_plural }}/search" aria-label="Reset search">Reset</a>
        <button class="button"
                type="button"
                aria-label="Open filter drawer"
                aria-haspopup="dialog"
                x-bind:aria-expanded="drawerOpen ? 'true' : 'false'"
                @click="drawerOpen = true">Filters</button>
      </div>

      <div class="drawer-backdrop"
           x-show="drawerOpen"
           x-transition.opacity
           @click="drawerOpen = false"
           aria-hidden="true"></div>

      <aside class="drawer"
             role="dialog"
             aria-modal="true"
             aria-label="Search filters"
             x-bind:data-open="drawerOpen ? 'true' : 'false'"
             @keydown.escape.window="drawerOpen = false">
        <header>
          <h3>Filters</h3>
          <button class="action-bar-button"
                  type="button"
                  aria-label="Close filter drawer"
                  @click="drawerOpen = false">&times;</button>
        </header>

        <div class="field" aria-label="Fuzzy field">
          <label class="label" for="fuzzy">
            <input id="fuzzy"
                   type="checkbox"
                   name="fuzzy"
                   value="true"
                   aria-label="Enable fuzzy matching"
                   {% if fuzzy %}checked{% endif %}>
            Fuzzy matching
          </label>
          <span class="hint">Tolerate typos and small spelling differences.</span>
        </div>

        <div class="field" aria-label="Phonetic field">
          <label class="label" for="phonetic">
            <input id="phonetic"
                   type="checkbox"
                   name="phonetic"
                   value="true"
                   aria-label="Enable phonetic matching"
                   {% if phonetic %}checked{% endif %}>
            Phonetic matching (Soundex)
          </label>
          <span class="hint">Match names that sound alike (Smith / Smyth).</span>
        </div>

        <div class="field" aria-label="Mask sensitive field">
          <label class="label" for="mask-sensitive">
            <input id="mask-sensitive"
                   type="checkbox"
                   name="mask_sensitive"
                   value="true"
                   aria-label="Mask sensitive fields in results"
                   {% if mask_sensitive %}checked{% endif %}>
            Mask sensitive fields
          </label>
          <span class="hint">Apply privacy masking to identifiers, phones, SSN, NHS number.</span>
        </div>

        <div class="action-bar" role="toolbar" aria-label="Drawer actions">
          <button class="button" type="submit" aria-label="Apply filters and search">Apply</button>
          <button class="button"
                  type="button"
                  aria-label="Close filter drawer without applying"
                  @click="drawerOpen = false">Close</button>
        </div>
      </aside>
    </form>
  </div>

  {% if active_filters and active_filters | length > 0 %}
    <div class="tag-group" aria-label="Active filters">
      {% for f in active_filters %}
        <span class="tag" aria-label="Active filter: {{ f }}">{{ f }}</span>
      {% endfor %}
    </div>
  {% endif %}

  {% if not query or query | length == 0 %}
    <p>
      <span class="hint" aria-label="Empty query hint">
        Enter a query above to search {{ entity_plural }}.
      </span>
    </p>
  {% elif results | length == 0 %}
    <div class="alert" role="alert" aria-label="No results" data-type="info">
      No {{ entity_plural }} match &ldquo;{{ query }}&rdquo;.
    </div>
  {% else %}
    <p>
      <span class="hint" aria-label="Result summary">
        {{ result_total }} match{% if result_total != 1 %}es{% endif %}
        for &ldquo;{{ query }}&rdquo;.
      </span>
    </p>

    <table class="data-table" aria-label="Search results">
      <thead class="data-table-head">
        <tr class="data-table-row">
          <th class="data-table-th" scope="col">Label</th>
          <th class="data-table-th" scope="col">Subtitle</th>
          <th class="data-table-th" scope="col">Status</th>
          <th class="data-table-th" scope="col">Relevance</th>
        </tr>
      </thead>
      <tbody class="data-table-body">
        {% for r in results %}
          <tr class="data-table-row">
            <td class="data-table-td">
              <a href="/{{ entity_plural }}/{{ r.id }}">{{ r.label }}</a>
            </td>
            <td class="data-table-td">{{ r.subtitle | default(value="") }}</td>
            <td class="data-table-td">
              {% if r.active %}
                <span class="badge" data-type="success" aria-label="Active">Active</span>
              {% else %}
                <span class="badge" data-type="error" aria-label="Inactive">Inactive</span>
              {% endif %}
            </td>
            <td class="data-table-td">
              <meter class="meter"
                     aria-label="Relevance {{ r.relevance_pct }} percent"
                     min="0"
                     max="100"
                     low="40"
                     high="80"
                     optimum="100"
                     value="{{ r.relevance_pct }}">{{ r.relevance_pct }}%</meter>
            </td>
          </tr>
        {% endfor %}
      </tbody>
    </table>

    {% if pagination and pagination.total_pages > 1 %}
      <nav class="pagination-nav" aria-label="Search results pagination">
        <ol class="pagination-list" aria-label="Page links">
          {% if pagination.has_prev %}
            <li class="pagination-list-item">
              <a class="pagination-link"
                 href="/{{ entity_plural }}/search?q={{ query }}&page={{ pagination.page - 1 }}"
                 aria-label="Previous page">Previous</a>
            </li>
          {% endif %}
          {% for p in pagination.pages %}
            <li class="pagination-list-item">
              {% if p == pagination.page %}
                <span aria-current="page" aria-label="Page {{ p }}, current">{{ p }}</span>
              {% else %}
                <a class="pagination-link"
                   href="/{{ entity_plural }}/search?q={{ query }}&page={{ p }}"
                   aria-label="Page {{ p }}">{{ p }}</a>
              {% endif %}
            </li>
          {% endfor %}
          {% if pagination.has_next %}
            <li class="pagination-list-item">
              <a class="pagination-link"
                 href="/{{ entity_plural }}/search?q={{ query }}&page={{ pagination.page + 1 }}"
                 aria-label="Next page">Next</a>
            </li>
          {% endif %}
        </ol>
      </nav>
    {% endif %}
  {% endif %}
</section>
{% endblock content %}
