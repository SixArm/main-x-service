{% extends "layout.html.tera" %}

{% block title %}Starred &mdash; {{ entity_plural | capitalize }} &mdash; {{ app_display }}{% endblock title %}

{% block content %}
<nav class="breadcrumb-nav" aria-label="Breadcrumb">
  <ol class="breadcrumb-list" aria-label="Breadcrumb trail">
    <li class="breadcrumb-list-item"><a href="/">Home</a></li>
    <li class="breadcrumb-list-item"><a href="/{{ entity_plural }}">{{ entity_plural | capitalize }}</a></li>
    <li class="breadcrumb-list-item" aria-current="page">Starred</li>
  </ol>
</nav>

<section aria-label="Starred {{ entity_plural }}"
         x-data='{
           starred: JSON.parse(localStorage.getItem("lily-starred-{{ entity_plural }}") || "[]"),
           isStarred(id) { return this.starred.includes(id); },
           toggleStar(id, label) {
             var i = this.starred.indexOf(id);
             if (i === -1) {
               this.starred.push(id);
               window.lily.toast("Starred " + label, "success");
             } else {
               this.starred.splice(i, 1);
               window.lily.toast("Unstarred " + label, "info");
             }
             localStorage.setItem("lily-starred-{{ entity_plural }}", JSON.stringify(this.starred));
           },
           clearAll() {
             this.starred = [];
             localStorage.removeItem("lily-starred-{{ entity_plural }}");
             window.lily.toast("Cleared all starred {{ entity_plural }}", "info");
           },
           visibleCount() { return this.starred.length; }
         }'>
  <h2>Starred &mdash; {{ entity_plural | capitalize }}</h2>
  <p>
    <span class="hint" aria-label="Starred summary">
      Per-browser favourites stored in
      <code>localStorage["lily-starred-{{ entity_plural }}"]</code>.
      <span x-text="visibleCount() + ' ' + (visibleCount() === 1 ? '{{ entity_singular }}' : '{{ entity_plural }}') + ' starred'"></span>.
    </span>
  </p>

  <div class="action-bar" role="toolbar" aria-label="Starred actions">
    <a class="button"
       href="/{{ entity_plural }}"
       aria-label="Back to all {{ entity_plural }}">&larr; All {{ entity_plural }}</a>
    <button class="action-bar-button"
            type="button"
            data-destructive
            aria-label="Clear all starred {{ entity_plural }}"
            x-show="starred.length > 0"
            onclick="document.getElementById('clear-starred-confirm').showModal()">Clear all</button>
  </div>

  <div class="alert"
       role="alert"
       data-type="info"
       aria-label="Empty starred list"
       x-show="starred.length === 0">
    No starred {{ entity_plural }}. Open any {{ entity_singular }} or
    the {{ entity_plural }} index, click the
    <span class="star-button-icon" aria-hidden="true">☆</span> button,
    and the record will appear here.
  </div>

  <table class="data-table"
         aria-label="Starred {{ entity_plural }}"
         x-show="starred.length > 0">
    <thead class="data-table-head">
      <tr class="data-table-row">
        <th class="data-table-th" scope="col"><span class="screen-reader-span">Star</span></th>
        <th class="data-table-th" scope="col">Label</th>
        <th class="data-table-th" scope="col">Subtitle</th>
        <th class="data-table-th" scope="col">Status</th>
      </tr>
    </thead>
    <tbody class="data-table-body">
      {% for r in candidates %}
        <tr class="data-table-row"
            x-show="isStarred('{{ r.id }}')"
            x-transition>
          <td class="data-table-td">
            <button class="star-button"
                    type="button"
                    role="switch"
                    aria-label="Unstar {{ r.label }}"
                    x-bind:aria-pressed="isStarred('{{ r.id }}') ? 'true' : 'false'"
                    x-bind:data-state="isStarred('{{ r.id }}') ? 'on' : 'off'"
                    @click="toggleStar('{{ r.id }}', '{{ r.label }}')">
              <span class="star-button-icon" aria-hidden="true" x-text="isStarred('{{ r.id }}') ? '★' : '☆'"></span>
            </button>
          </td>
          <td class="data-table-td">
            <a href="/{{ entity_plural }}/{{ r.id }}">{{ r.label }}</a>
          </td>
          <td class="data-table-td">{{ r.subtitle | default(value="") }}</td>
          <td class="data-table-td">
            {% if r.active %}
              <span class="badge" data-type="success" aria-label="Active">Active</span>
            {% else %}
              <span class="badge" data-type="error" aria-label="Inactive">Inactive</span>
            {% endif %}
          </td>
        </tr>
      {% endfor %}
    </tbody>
  </table>

  <dialog id="clear-starred-confirm"
          class="alert-dialog"
          role="alertdialog"
          aria-modal="true"
          aria-labelledby="clear-starred-confirm-title"
          aria-describedby="clear-starred-confirm-body">
    <h2 id="clear-starred-confirm-title">Clear all starred {{ entity_plural }}?</h2>
    <p id="clear-starred-confirm-body">
      This removes all stars from
      <code>localStorage["lily-starred-{{ entity_plural }}"]</code>. The
      underlying {{ entity_plural }} are unaffected. This action only
      clears this browser's view.
    </p>
    <form method="dialog" class="form" aria-label="Confirm clear all">
      <button class="button" type="submit" value="cancel" aria-label="Cancel">Cancel</button>
      <button class="button"
              type="submit"
              value="confirm"
              data-destructive
              aria-label="Clear all stars"
              @click="clearAll()">Clear all</button>
    </form>
  </dialog>
</section>
{% endblock content %}
