# Server-side BFF env vars (read by src/lib/server/config.ts; never exposed
# to the client bundle — the browser only ever calls the same-origin
# /api/proxy route). No trailing slash.

# Place Service REST API base URL. The proxy forwards entity-API calls
# here with a server-injected PASETO.
PLACE_API_URL=http://localhost:5150

# Authentication Service base URL — magic-link login + session->PASETO
# exchange.
AUTH_API_URL=http://localhost:5150
