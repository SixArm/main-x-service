# Server-side BFF variables (read in src/lib/server/config.ts; never
# bundled into the browser). The browser talks only to this app's own
# origin — entity-API calls go through the same-origin /api/proxy route.

# Event Service REST API base URL (no trailing slash).
EVENT_API_URL=http://localhost:5150

# Authentication Service base URL (session -> PASETO exchange, magic-link).
AUTH_API_URL=http://localhost:5150
