# Authentication Service base URL (no trailing slash), read SERVER-SIDE
# only by the BFF (src/lib/server/auth.ts, src/lib/server/admin.ts).
# 5150 is the loco.rs default port the auth service binds in dev. This is
# the var that actually configures the running app.
AUTH_API_URL=http://localhost:5150

# Shows the "Sign in with SSO" link on /signin and enables the
# /signin/sso redirect route (EV-2, agents/share/authentication-sessions.md
# §7a). This is a plain boolean flag, not an API base URL — see Ground
# rule 6 in AGENTS.md for why AUTH_API_URL itself stays server-only.
# Set this ONLY when the paired auth-service deployment has its own
# AUTH_OIDC_* variables configured; unset (the default) hides the link
# entirely, matching magic link staying the default sign-in path.
# PUBLIC_OIDC_SIGNIN_ENABLED=true
