# Authentication Service base URL (no trailing slash), read SERVER-SIDE
# only by the BFF (src/lib/server/auth.ts, src/lib/server/admin.ts).
# 5150 is the loco.rs default port the auth service binds in dev. This is
# the var that actually configures the running app.
AUTH_API_URL=http://localhost:5150

# Legacy — NOT read by any route. `PUBLIC_API_BASE_URL` /
# `VITE_RETURN_TO_ALLOWLIST` fed the pre-BFF client-held-token model
# (src/lib/config.ts -> src/lib/api/client.ts + src/lib/api/auth.ts) and
# the cross-origin `return_to#access_token=` handoff, both removed when
# this front-end migrated to httpOnly-cookie sessions (spec/index.md
# §13). Their only remaining callers are their own unit tests
# (tests/unit/client.test.ts, auth.test.ts); setting them has no effect
# on `pnpm dev`/`pnpm build`. Left commented out so a fresh `.env` does
# not appear to configure something it doesn't.
# PUBLIC_API_BASE_URL=http://localhost:5150
# VITE_RETURN_TO_ALLOWLIST=
