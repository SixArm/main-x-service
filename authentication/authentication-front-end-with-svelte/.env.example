# Authentication Service base URL (no trailing slash).
# 5150 is the loco.rs default port the auth service binds in dev.
PUBLIC_API_BASE_URL=http://localhost:5150

# Cross-origin SSO handoff allowlist: comma-separated operator-app
# origins (exact scheme://host[:port]) the issued access token may be
# redirected to via /verify?...#access_token=. Unset/empty ⇒ same-origin
# only. This is the control that stops token exfiltration via a crafted
# ?return_to=. Example:
# VITE_RETURN_TO_ALLOWLIST=https://organization.example.com,https://case.example.com
VITE_RETURN_TO_ALLOWLIST=
