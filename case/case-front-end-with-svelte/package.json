{
  "name": "case-front-end-with-svelte",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "=26"
  },
  "description": "SvelteKit front-end for the Case Service (Main X Index): case CRUD + matching.",
  "license": "MIT OR Apache-2.0",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write src",
    "lint": "prettier --check src"
  },
  "dependencies": {
    "@svar-ui/svelte-calendar": "^2.7.1",
    "@svar-ui/svelte-filemanager": "^2.6.0",
    "@svar-ui/svelte-filter": "^2.6.1",
    "@svar-ui/svelte-gantt": "^2.7.3",
    "@svar-ui/svelte-grid": "^2.7.3",
    "@svar-ui/svelte-kanban": "^2.6.0",
    "@lilydesignsystem/svelte-headless": "^0.1.0",
    "@lilydesignsystem/svelte-locale-picker": "^0.1.0",
    "@lilydesignsystem/svelte-picker-bar": "^0.1.0",
    "@lilydesignsystem/svelte-share-picker": "^0.1.0",
    "@lilydesignsystem/svelte-text-size-picker": "^0.1.0",
    "@lilydesignsystem/svelte-theme-picker": "^0.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^22.0.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.8",
    "prettier-plugin-svelte": "^3.3.0",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "^5.8.0",
    "vite": "^6.2.0",
    "vitest": "^3.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
