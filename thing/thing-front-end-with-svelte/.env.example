# Server-side BFF config (never exposed to the browser bundle — see
# src/lib/server/config.ts). The browser only ever calls the same-origin
# /api/proxy route; there is no public/client-held API base URL.

# Thing Service REST API base URL (no trailing slash). The BFF proxy
# injects a server-exchanged PASETO and forwards requests here.
THING_API_URL=http://localhost:5150

# Authentication Service base URL (no trailing slash). Used for the
# magic-link login flow and the session -> PASETO exchange.
AUTH_API_URL=http://localhost:5150
