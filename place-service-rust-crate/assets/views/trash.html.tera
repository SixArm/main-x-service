{% extends "layout.html.tera" %}

{% block title %}Trash &mdash; {{ entity_plural | capitalize }} &mdash; {{ app_display }}{% endblock title %}

{% block content %}
<nav class="breadcrumb-nav" aria-label="Breadcrumb">
  <ol class="breadcrumb-list" aria-label="Breadcrumb trail">
    <li class="breadcrumb-list-item"><a href="/">Home</a></li>
    <li class="breadcrumb-list-item"><a href="/{{ entity_plural }}">{{ entity_plural | capitalize }}</a></li>
    <li class="breadcrumb-list-item" aria-current="page">Trash</li>
  </ol>
</nav>

<section aria-label="Soft-deleted {{ entity_plural }}"
         x-data='{
           selected: [],
           menuOpen: false,
           activeMenuItem: 0,
           menuItems: ["restore", "delete-forever", "export"],
           toggleMenu() { this.menuOpen = !this.menuOpen; this.activeMenuItem = 0; },
           closeMenu() { this.menuOpen = false; },
           focusMenuItem(idx) {
             this.activeMenuItem = idx;
             this.$nextTick(() => {
               var items = this.$root.querySelectorAll("[role=menuitem]");
               if (items[idx]) items[idx].focus();
             });
           },
           onMenuKey(evt) {
             if (evt.key === "ArrowDown") { evt.preventDefault(); this.focusMenuItem((this.activeMenuItem + 1) % this.menuItems.length); }
             else if (evt.key === "ArrowUp") { evt.preventDefault(); this.focusMenuItem((this.activeMenuItem - 1 + this.menuItems.length) % this.menuItems.length); }
             else if (evt.key === "Home") { evt.preventDefault(); this.focusMenuItem(0); }
             else if (evt.key === "End") { evt.preventDefault(); this.focusMenuItem(this.menuItems.length - 1); }
             else if (evt.key === "Escape") { this.closeMenu(); this.$refs.menuTrigger.focus(); }
           },
           runBulk(action) {
             this.closeMenu();
             if (action === "restore") {
               window.lily.toast("Restored " + this.selected.length + " {{ entity_plural }}", "success");
             } else if (action === "delete-forever") {
               document.getElementById("bulk-purge-confirm").showModal();
             } else if (action === "export") {
               window.lily.toast("Export queued for " + this.selected.length + " {{ entity_plural }}", "info");
             }
           }
         }'
         @click.outside="closeMenu()">
  <h2>Trash &mdash; {{ entity_plural | capitalize }}</h2>
  <p>
    <span class="hint" aria-label="Trash summary">
      {{ items | length }} soft-deleted {{ entity_singular }}{% if items | length != 1 %}s{% endif %}.
      Soft-deleted records remain queryable from the audit log and can
      be restored to active status. Permanent deletion removes the row
      from the database and is irreversible.
    </span>
  </p>

  <div class="action-bar" role="toolbar" aria-label="Trash actions">
    <a class="button"
       href="/{{ entity_plural }}"
       aria-label="Return to active {{ entity_plural }}">&larr; Active {{ entity_plural }}</a>
  </div>

  {% if items | length == 0 %}
    <div class="alert" role="alert" aria-label="Empty trash" data-type="info">
      No soft-deleted {{ entity_plural }}. Records appear here when
      <code>DELETE /api/{{ entity_plural }}/{id}</code> is called.
    </div>
  {% else %}
    <div class="action-bar"
         role="toolbar"
         aria-label="Bulk trash actions"
         x-show="selected.length > 0"
         x-transition
         x-bind:data-selected-count="selected.length">
      <span class="action-bar-count" x-text="selected.length + ' selected'"></span>

      <div class="dropdown-menu" aria-label="Bulk action dropdown">
        <button class="dropdown-menu-button"
                type="button"
                aria-label="Open bulk action menu"
                aria-haspopup="menu"
                x-ref="menuTrigger"
                x-bind:aria-expanded="menuOpen ? 'true' : 'false'"
                @click="toggleMenu()"
                @keydown.arrow-down.prevent="toggleMenu(); focusMenuItem(0);">
          Choose bulk action &#9662;
        </button>
        <ol class="dropdown-menu-list"
            role="menu"
            aria-label="Bulk actions"
            x-show="menuOpen"
            x-transition
            @keydown="onMenuKey($event)">
          <li class="dropdown-menu-list-item" role="none">
            <button class="dropdown-menu-item"
                    type="button"
                    role="menuitem"
                    tabindex="-1"
                    aria-label="Restore selected to active"
                    @click="runBulk('restore')">Restore selected</button>
          </li>
          <li class="dropdown-menu-list-item" role="none">
            <button class="dropdown-menu-item"
                    type="button"
                    role="menuitem"
                    tabindex="-1"
                    aria-label="Permanently delete selected"
                    data-destructive
                    @click="runBulk('delete-forever')">Permanently delete selected</button>
          </li>
          <li class="dropdown-menu-list-item" role="none">
            <button class="dropdown-menu-item"
                    type="button"
                    role="menuitem"
                    tabindex="-1"
                    aria-label="Export selected as JSON"
                    @click="runBulk('export')">Export selected as JSON</button>
          </li>
        </ol>
      </div>

      <button class="action-bar-clear"
              type="button"
              aria-label="Clear selection"
              @click="selected = []">&times;</button>
    </div>

    <table class="data-table" aria-label="Soft-deleted {{ entity_plural }}">
      <thead class="data-table-head">
        <tr class="data-table-row">
          <th class="data-table-th" scope="col">
            <label class="label" for="trash-select-all">
              <input class="checkbox-input"
                     type="checkbox"
                     id="trash-select-all"
                     aria-label="Select all soft-deleted {{ entity_plural }}"
                     @change="selected = $event.target.checked ? {{ items | map(attribute='id') | json_encode | safe }} : []">
              <span class="hint">Select all</span>
            </label>
          </th>
          <th class="data-table-th" scope="col">Label</th>
          <th class="data-table-th" scope="col">Soft-deleted at</th>
          <th class="data-table-th" scope="col">Deleted by</th>
          <th class="data-table-th" scope="col">Reason</th>
          <th class="data-table-th" scope="col">Actions</th>
        </tr>
      </thead>
      <tbody class="data-table-body">
        {% for item in items %}
          <tr class="data-table-row" data-state="trashed">
            <td class="data-table-td">
              <input class="checkbox-input"
                     type="checkbox"
                     aria-label="Select {{ item.label }}"
                     value="{{ item.id }}"
                     x-model="selected">
            </td>
            <td class="data-table-td">
              <a href="/{{ entity_plural }}/{{ item.id }}">{{ item.label }}</a>
            </td>
            <td class="data-table-td">
              <time datetime="{{ item.deleted_at }}">{{ item.deleted_at }}</time>
            </td>
            <td class="data-table-td">
              <code>{{ item.deleted_by | default(value="system") }}</code>
            </td>
            <td class="data-table-td">
              <span class="hint" aria-label="Deletion reason">{{ item.reason | default(value="—") }}</span>
            </td>
            <td class="data-table-td">
              <button class="button"
                      type="button"
                      aria-label="Restore {{ item.label }} to active"
                      hx-post="/api/{{ entity_plural }}/{{ item.id }}/restore"
                      hx-target="closest tr"
                      hx-swap="outerHTML"
                      onclick="lily.toast('Restored {{ item.label }}', 'success')">Restore</button>
              <button class="action-bar-button"
                      type="button"
                      data-destructive
                      aria-label="Permanently delete {{ item.label }}"
                      onclick="document.getElementById('purge-confirm-{{ item.id }}').showModal()">
                Delete forever
              </button>

              <dialog id="purge-confirm-{{ item.id }}"
                      class="alert-dialog"
                      role="alertdialog"
                      aria-modal="true"
                      aria-labelledby="purge-confirm-{{ item.id }}-title"
                      aria-describedby="purge-confirm-{{ item.id }}-body">
                <h2 id="purge-confirm-{{ item.id }}-title">Permanently delete?</h2>
                <p id="purge-confirm-{{ item.id }}-body">
                  This removes <strong>{{ item.label }}</strong> from the
                  database. The audit log entry is retained, but the
                  record itself cannot be recovered. Consider exporting
                  the GDPR data bundle first.
                </p>
                <form method="dialog" class="form" aria-label="Confirm permanent delete">
                  <button class="button" type="submit" value="cancel" aria-label="Cancel">Cancel</button>
                  <button class="button"
                          type="submit"
                          value="confirm"
                          data-destructive
                          aria-label="Permanently delete"
                          hx-delete="/api/{{ entity_plural }}/{{ item.id }}/purge"
                          hx-target="closest tr"
                          hx-swap="outerHTML"
                          onclick="lily.toast('Permanently deleted {{ item.label }}', 'success')">Delete forever</button>
                </form>
              </dialog>
            </td>
          </tr>
        {% endfor %}
      </tbody>
    </table>

    <dialog id="bulk-purge-confirm"
            class="alert-dialog"
            role="alertdialog"
            aria-modal="true"
            aria-labelledby="bulk-purge-confirm-title"
            aria-describedby="bulk-purge-confirm-body">
      <h2 id="bulk-purge-confirm-title">Permanently delete selected?</h2>
      <p id="bulk-purge-confirm-body">
        This removes <strong x-text="selected.length"></strong>
        {{ entity_plural }} from the database. The audit log entries are
        retained, but the records themselves cannot be recovered.
      </p>
      <form method="dialog" class="form" aria-label="Confirm bulk permanent delete">
        <button class="button" type="submit" value="cancel" aria-label="Cancel">Cancel</button>
        <button class="button"
                type="submit"
                value="confirm"
                data-destructive
                aria-label="Permanently delete all selected"
                @click="window.lily.toast('Permanently deleted ' + selected.length + ' {{ entity_plural }}', 'success'); selected = [];">
          Delete forever
        </button>
      </form>
    </dialog>

    {% if pagination and pagination.total_pages > 1 %}
      <nav class="pagination-nav" aria-label="Trash pagination">
        <ol class="pagination-list" aria-label="Page links">
          {% if pagination.has_prev %}
            <li class="pagination-list-item">
              <a class="pagination-link"
                 href="/{{ entity_plural }}/trash?page={{ pagination.page - 1 }}"
                 aria-label="Previous page">Previous</a>
            </li>
          {% endif %}
          {% for p in pagination.pages %}
            <li class="pagination-list-item">
              {% if p == pagination.page %}
                <span aria-current="page" aria-label="Page {{ p }}, current">{{ p }}</span>
              {% else %}
                <a class="pagination-link"
                   href="/{{ entity_plural }}/trash?page={{ p }}"
                   aria-label="Page {{ p }}">{{ p }}</a>
              {% endif %}
            </li>
          {% endfor %}
          {% if pagination.has_next %}
            <li class="pagination-list-item">
              <a class="pagination-link"
                 href="/{{ entity_plural }}/trash?page={{ pagination.page + 1 }}"
                 aria-label="Next page">Next</a>
            </li>
          {% endif %}
        </ol>
      </nav>
    {% endif %}
  {% endif %}
</section>
{% endblock content %}
