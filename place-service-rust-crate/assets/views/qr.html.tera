{% extends "layout.html.tera" %}

{% block title %}QR &mdash; {{ record.label }} &mdash; {{ app_display }}{% endblock title %}

{% block content %}
<nav class="breadcrumb-nav" aria-label="Breadcrumb">
  <ol class="breadcrumb-list" aria-label="Breadcrumb trail">
    <li class="breadcrumb-list-item"><a href="/">Home</a></li>
    <li class="breadcrumb-list-item"><a href="/{{ entity_plural }}">{{ entity_plural | capitalize }}</a></li>
    <li class="breadcrumb-list-item"><a href="/{{ entity_plural }}/{{ record.id }}">{{ record.label }}</a></li>
    <li class="breadcrumb-list-item" aria-current="page">QR</li>
  </ol>
</nav>

<section aria-label="QR code share">
  <h2>QR code &mdash; {{ record.label }}</h2>

  <div class="information-callout" aria-label="QR code notice">
    <p>
      Print this code on a wristband, label, or referral letter to deep-link
      back to <code>{{ share_url }}</code>. The image below is a server-rendered
      <strong>placeholder pattern</strong> derived from a hash of the URL;
      production renders a real QR via the <code>qrcode</code> Rust crate.
    </p>
  </div>

  <div class="diff" role="group" aria-label="QR code and metadata">
    <article class="card" role="region" aria-label="QR image">
      <div class="qr-code"
           aria-label="QR code for {{ record.label }} ({{ share_url }})">
        {{ qr_svg | safe }}
      </div>
    </article>

    <article class="card" role="region" aria-label="QR metadata">
      <ol class="summary-list" aria-label="QR metadata">
        <li class="summary-list-item">
          <dl>
            <dt>{{ entity_singular | capitalize }} ID</dt>
            <dd><code>{{ record.id }}</code></dd>
          </dl>
        </li>
        <li class="summary-list-item">
          <dl>
            <dt>Encoded URL</dt>
            <dd>
              <code>{{ share_url }}</code>
              <button class="clipboard-copy-button"
                      type="button"
                      aria-label="Copy URL to clipboard"
                      data-clipboard-text="{{ share_url }}"
                      data-copied-message="URL copied">Copy</button>
            </dd>
          </dl>
        </li>
        <li class="summary-list-item">
          <dl>
            <dt>Pixel size</dt>
            <dd>{{ pixel_size }} × {{ pixel_size }} px</dd>
          </dl>
        </li>
        <li class="summary-list-item">
          <dl>
            <dt>Module grid</dt>
            <dd>{{ module_grid }} × {{ module_grid }} modules</dd>
          </dl>
        </li>
        <li class="summary-list-item">
          <dl>
            <dt>Generated at</dt>
            <dd><time datetime="{{ generated_at }}">{{ generated_at }}</time></dd>
          </dl>
        </li>
      </ol>

      <div class="action-bar" role="toolbar" aria-label="QR actions">
        <a class="button"
           href="/{{ entity_plural }}/{{ record.id }}/qr.svg"
           download="{{ entity_singular }}-{{ record.id }}-qr.svg"
           aria-label="Download QR as SVG">Download SVG</a>
        <button class="button"
                type="button"
                aria-label="Print this QR code"
                onclick="window.print(); lily.toast('Sending QR to print', 'info')">Print</button>
        <a class="button"
           href="/{{ entity_plural }}/{{ record.id }}"
           aria-label="Back to {{ entity_singular }} detail">Back</a>
      </div>
    </article>
  </div>
</section>
{% endblock content %}
