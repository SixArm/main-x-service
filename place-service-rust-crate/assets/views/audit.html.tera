{% extends "layout.html.tera" %}

{% block title %}Audit log &mdash; {{ record.label }} &mdash; {{ app_display }}{% endblock title %}

{% block content %}
<nav class="breadcrumb-nav" aria-label="Breadcrumb">
  <ol class="breadcrumb-list" aria-label="Breadcrumb trail">
    <li class="breadcrumb-list-item"><a href="/">Home</a></li>
    <li class="breadcrumb-list-item"><a href="/{{ entity_plural }}">{{ entity_plural | capitalize }}</a></li>
    <li class="breadcrumb-list-item"><a href="/{{ entity_plural }}/{{ record.id }}">{{ record.label }}</a></li>
    <li class="breadcrumb-list-item" aria-current="page">Audit log</li>
  </ol>
</nav>

<section aria-label="Audit log">
  <h2>Audit log &mdash; {{ record.label }}</h2>
  <p>
    <span class="hint" aria-label="Audit description">
      HIPAA-compliant audit trail for this {{ entity_singular }} record.
      {{ entries | length }} event{% if entries | length != 1 %}s{% endif %} shown.
    </span>
  </p>

  <form class="form"
        aria-label="Filter audit log"
        hx-get="/{{ entity_plural }}/{{ record.id }}/audit"
        hx-target="#audit-timeline"
        hx-select="#audit-timeline"
        hx-swap="outerHTML"
        hx-trigger="change">
    <div class="field" aria-label="Action filter field">
      <label class="label" for="action-filter">Action</label>
      <select class="select"
              id="action-filter"
              name="action"
              aria-label="Filter by action">
        <option class="option" value="">All actions</option>
        <option class="option" value="Created" {% if filter_action == "Created" %}selected{% endif %}>Created</option>
        <option class="option" value="Updated" {% if filter_action == "Updated" %}selected{% endif %}>Updated</option>
        <option class="option" value="Deleted" {% if filter_action == "Deleted" %}selected{% endif %}>Deleted</option>
        <option class="option" value="Merged" {% if filter_action == "Merged" %}selected{% endif %}>Merged</option>
        <option class="option" value="Linked" {% if filter_action == "Linked" %}selected{% endif %}>Linked</option>
        <option class="option" value="Unlinked" {% if filter_action == "Unlinked" %}selected{% endif %}>Unlinked</option>
      </select>
    </div>
  </form>

  {% if entries | length == 0 %}
    <div class="alert" role="alert" aria-label="Empty audit log" data-type="info">
      No audit events match the current filter.
    </div>
  {% else %}
    <ol class="timeline-list" id="audit-timeline" aria-label="Audit events, newest first">
      {% for entry in entries %}
        <li class="timeline-list-item">
          <header>
            {% if entry.action == "Created" %}
              <span class="badge" data-type="success" aria-label="Action: Created">Created</span>
            {% elif entry.action == "Updated" %}
              <span class="badge" data-type="info" aria-label="Action: Updated">Updated</span>
            {% elif entry.action == "Deleted" %}
              <span class="badge" data-type="error" aria-label="Action: Deleted">Deleted</span>
            {% elif entry.action == "Merged" %}
              <span class="badge" data-type="warning" aria-label="Action: Merged">Merged</span>
            {% else %}
              <span class="badge" aria-label="Action: {{ entry.action }}">{{ entry.action }}</span>
            {% endif %}
            <time datetime="{{ entry.at }}">{{ entry.at }}</time>
          </header>

          <ol class="summary-list" aria-label="Event details">
            <li class="summary-list-item">
              <dl>
                <dt>User</dt>
                <dd>
                  <code>{{ entry.user_id | default(value="system") }}</code>
                  {% if entry.user_ip %}
                    <span class="hint" aria-label="User IP address">from {{ entry.user_ip }}</span>
                  {% endif %}
                </dd>
              </dl>
            </li>
            {% if entry.user_agent %}
              <li class="summary-list-item">
                <dl>
                  <dt>User agent</dt>
                  <dd><code>{{ entry.user_agent }}</code></dd>
                </dl>
              </li>
            {% endif %}
            {% if entry.summary %}
              <li class="summary-list-item">
                <dl>
                  <dt>Summary</dt>
                  <dd>{{ entry.summary }}</dd>
                </dl>
              </li>
            {% endif %}
          </ol>

          {% if entry.old_value or entry.new_value %}
            <details class="details" aria-label="Changed values">
              <summary>Old / new values</summary>
              {% if entry.old_value %}
                <p><strong>Before</strong></p>
                <pre class="code-block" aria-label="Old value JSON"><code>{{ entry.old_value }}</code></pre>
              {% endif %}
              {% if entry.new_value %}
                <p><strong>After</strong></p>
                <pre class="code-block" aria-label="New value JSON"><code>{{ entry.new_value }}</code></pre>
              {% endif %}
            </details>
          {% endif %}
        </li>
      {% endfor %}
    </ol>

    {% if pagination and pagination.total_pages > 1 %}
      <nav class="pagination-nav" aria-label="Audit log pagination">
        <ol class="pagination-list" aria-label="Page links">
          {% if pagination.has_prev %}
            <li class="pagination-list-item">
              <a class="pagination-link"
                 href="/{{ entity_plural }}/{{ record.id }}/audit?page={{ pagination.page - 1 }}"
                 aria-label="Previous page">Previous</a>
            </li>
          {% endif %}
          {% for p in pagination.pages %}
            <li class="pagination-list-item">
              {% if p == pagination.page %}
                <span aria-current="page" aria-label="Page {{ p }}, current">{{ p }}</span>
              {% else %}
                <a class="pagination-link"
                   href="/{{ entity_plural }}/{{ record.id }}/audit?page={{ p }}"
                   aria-label="Page {{ p }}">{{ p }}</a>
              {% endif %}
            </li>
          {% endfor %}
          {% if pagination.has_next %}
            <li class="pagination-list-item">
              <a class="pagination-link"
                 href="/{{ entity_plural }}/{{ record.id }}/audit?page={{ pagination.page + 1 }}"
                 aria-label="Next page">Next</a>
            </li>
          {% endif %}
        </ol>
      </nav>
    {% endif %}
  {% endif %}
</section>
{% endblock content %}
