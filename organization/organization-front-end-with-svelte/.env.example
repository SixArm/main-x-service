# Organization Service base URL (no trailing slash), read server-side
# by the BFF proxy (src/lib/server/config.ts). 5150 is the loco.rs
# default port the service binds in dev.
ORGANIZATION_API_URL=http://localhost:5150

# Authentication service base URL (no trailing slash), read server-side
# for the magic-link sign-in flow and the session -> PASETO exchange
# (src/lib/server/auth.ts). Same default port as the organization
# service in a typical single-machine dev setup.
AUTH_API_URL=http://localhost:5150

# Shows the "Sign in with SSO" link on /signin and enables the
# /signin/sso redirect route (EV-2, agents/share/authentication-sessions.md
# §7a). A plain boolean flag, not a URL. Set ONLY when the paired
# auth-service has its AUTH_OIDC_* variables configured; unset (default)
# hides the link, and magic link stays the default sign-in path.
# PUBLIC_OIDC_SIGNIN_ENABLED=true
