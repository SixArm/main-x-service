# Organization Service base URL (no trailing slash).
# 5150 is the loco.rs default port the service binds in dev.
PUBLIC_API_BASE_URL=http://localhost:5150

# Central authentication front-end base URL (no trailing slash). The
# "Sign in" button sends the operator to ${VITE_AUTH_FRONTEND_URL}/signin
# and the access token is handed back via the URL fragment. Default is
# the auth front-end's vite dev port.
VITE_AUTH_FRONTEND_URL=http://localhost:5173
