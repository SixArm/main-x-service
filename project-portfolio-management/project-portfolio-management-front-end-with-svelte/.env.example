# Portfolio Service base URL (no trailing slash), read server-side by
# the BFF proxy (src/lib/server/config.ts, src/routes/api/proxy/[...path]).
# 5150 is the loco.rs default port the service binds in dev.
PROJECT_PORTFOLIO_MANAGEMENT_API_URL=http://localhost:5150

# Authentication service base URL (no trailing slash), read server-side
# for the magic-link sign-in flow and the session -> PASETO exchange
# (src/lib/server/auth.ts). Same default port as the portfolio service
# in a typical single-machine dev setup.
AUTH_API_URL=http://localhost:5150
