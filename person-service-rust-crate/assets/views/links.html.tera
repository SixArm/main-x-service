{% extends "layout.html.tera" %}

{% block title %}Links &mdash; {{ record.label }} &mdash; {{ app_display }}{% endblock title %}

{% block content %}
<nav class="breadcrumb-nav" aria-label="Breadcrumb">
  <ol class="breadcrumb-list" aria-label="Breadcrumb trail">
    <li class="breadcrumb-list-item"><a href="/">Home</a></li>
    <li class="breadcrumb-list-item"><a href="/{{ entity_plural }}">{{ entity_plural | capitalize }}</a></li>
    <li class="breadcrumb-list-item"><a href="/{{ entity_plural }}/{{ record.id }}">{{ record.label }}</a></li>
    <li class="breadcrumb-list-item" aria-current="page">Links</li>
  </ol>
</nav>

<section aria-label="{{ entity_singular | capitalize }} links"
         x-data="{ drawerOpen: false }">
  <h2>Links &mdash; {{ record.label }}</h2>

  <div class="information-callout" aria-label="Links explainer">
    <p>
      Links describe how this {{ entity_singular }} relates to other records.
      <strong>Replaces</strong> is created automatically by merge;
      <strong>ReplacedBy</strong> is its inverse and points to the surviving
      record. <strong>Refer</strong> and <strong>Seealso</strong> are manual
      cross-references.
    </p>
  </div>

  <div class="action-bar" role="toolbar" aria-label="Links actions">
    <span class="action-bar-count">{{ totals.total }} link{% if totals.total != 1 %}s{% endif %}</span>
    <button class="button"
            type="button"
            aria-label="Add a new link"
            aria-haspopup="dialog"
            x-bind:aria-expanded="drawerOpen ? 'true' : 'false'"
            @click="drawerOpen = true">Add link</button>
  </div>

  <nav class="tree-nav" aria-label="Linked {{ entity_plural }} grouped by link type">
    {% for group in groups %}
      <details open>
        <summary>
          {% if group.kind == "Replaces" %}
            <span class="badge" data-type="warning" aria-label="Group: Replaces">Replaces</span>
          {% elif group.kind == "ReplacedBy" %}
            <span class="badge" data-type="error" aria-label="Group: ReplacedBy">Replaced by</span>
          {% elif group.kind == "Refer" %}
            <span class="badge" data-type="info" aria-label="Group: Refer">Refer</span>
          {% elif group.kind == "Seealso" %}
            <span class="badge" data-type="success" aria-label="Group: Seealso">See also</span>
          {% else %}
            <span class="badge" aria-label="Group: {{ group.kind }}">{{ group.kind }}</span>
          {% endif %}
          <span>{{ group.description }}</span>
          <span class="hint" aria-label="Group count">({{ group.items | length }})</span>
        </summary>

        {% if group.items | length == 0 %}
          <p>
            <span class="hint" aria-label="Empty group">No {{ group.kind }} links.</span>
          </p>
        {% else %}
          <ol class="tree-list" role="tree" aria-label="{{ group.kind }} links">
            {% for link in group.items %}
              <li class="tree-list-item" role="treeitem">
                <a class="tree-link"
                   href="/{{ entity_plural }}/{{ link.target_id }}"
                   aria-label="Linked {{ entity_singular }}: {{ link.target_label }}">
                  {{ link.target_label }}
                </a>
                {% if link.merge_score %}
                  <span class="hint" aria-label="Merge score">
                    (score {{ link.merge_score }})
                  </span>
                {% endif %}
                {% if link.note %}
                  <p><span class="hint" aria-label="Link note">{{ link.note }}</span></p>
                {% endif %}
                <button class="action-bar-button"
                        type="button"
                        aria-label="Remove link to {{ link.target_label }}"
                        hx-delete="/api/{{ entity_plural }}/{{ record.id }}/links/{{ link.id }}"
                        hx-target="closest li"
                        hx-swap="outerHTML"
                        x-bind:disabled="{{ group.kind == 'Replaces' or group.kind == 'ReplacedBy' }}"
                        onclick="lily.toast('Link removed', 'warning')">
                  Remove
                </button>
              </li>
            {% endfor %}
          </ol>
        {% endif %}
      </details>
    {% endfor %}
  </nav>

  <div class="drawer-backdrop"
       x-show="drawerOpen"
       x-transition.opacity
       @click="drawerOpen = false"
       aria-hidden="true"></div>

  <aside class="drawer"
         role="dialog"
         aria-modal="true"
         aria-label="Add link"
         x-bind:data-open="drawerOpen ? 'true' : 'false'"
         @keydown.escape.window="drawerOpen = false">
    <header>
      <h3>Add link</h3>
      <button class="action-bar-button"
              type="button"
              aria-label="Close add-link drawer"
              @click="drawerOpen = false">&times;</button>
    </header>

    <form class="form"
          aria-label="Add link form"
          hx-post="/api/{{ entity_plural }}/{{ record.id }}/links"
          hx-target="body"
          hx-push-url="/{{ entity_plural }}/{{ record.id }}/links"
          @submit="lily.toast('Link added', 'success'); drawerOpen = false">
      <div class="field" aria-label="Link type field" data-required>
        <label class="label" for="link-kind">Link type</label>
        <span class="hint" id="link-kind-hint">
          <strong>Refer</strong> and <strong>Seealso</strong> are manual; <strong>Replaces</strong>/<strong>ReplacedBy</strong> are set by merge.
        </span>
        <select class="select"
                id="link-kind"
                name="link_type"
                aria-label="Link type"
                aria-describedby="link-kind-hint"
                required>
          <option class="option" value="Refer">Refer</option>
          <option class="option" value="Seealso">See also</option>
        </select>
      </div>

      <div class="field" aria-label="Target {{ entity_singular }} field" data-required>
        <label class="label" for="link-target">Target {{ entity_singular }} ID</label>
        <span class="hint" id="link-target-hint">UUID of the other {{ entity_singular }}.</span>
        <input class="text-input"
               type="text"
               id="link-target"
               name="target_id"
               aria-label="Target {{ entity_singular }} ID"
               aria-describedby="link-target-hint"
               placeholder="00000000-0000-0000-0000-000000000000"
               required>
      </div>

      <div class="field" aria-label="Note field">
        <label class="label" for="link-note">Note (optional)</label>
        <input class="text-input"
               type="text"
               id="link-note"
               name="note"
               aria-label="Link note"
               placeholder="e.g. clinician asserted same individual">
      </div>

      <div class="action-bar" role="toolbar" aria-label="Drawer actions">
        <button class="button" type="submit" aria-label="Add link">Add</button>
        <button class="button"
                type="button"
                aria-label="Close drawer without adding"
                @click="drawerOpen = false">Cancel</button>
      </div>
    </form>
  </aside>
</section>
{% endblock content %}
