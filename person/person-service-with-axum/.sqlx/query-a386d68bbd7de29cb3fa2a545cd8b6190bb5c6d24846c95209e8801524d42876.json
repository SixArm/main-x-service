{
  "db_name": "PostgreSQL",
  "query": "SELECT DISTINCT ON (p.id)\n                  p.id AS \"id!\",\n                  n.family AS \"family?\",\n                  n.given AS \"given?\",\n                  p.birth_date\n           FROM persons p\n           LEFT JOIN person_names n ON n.person_id = p.id AND n.is_primary\n           WHERE p.deleted_at IS NULL AND p.active = true\n             AND ($1::uuid IS NULL OR p.id > $1)\n           ORDER BY p.id, n.id\n           LIMIT $2",
