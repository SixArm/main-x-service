# Server-side BFF config (never exposed to the browser bundle — the
# browser only ever calls the same-origin `/api/proxy`; see
# `src/lib/server/config.ts` and README.md "Configuration").

# Person Service base URL (no trailing slash). loco dev default: 5150.
PERSON_API_URL=http://localhost:5150

# Authentication Service base URL — magic-link login + session->PASETO
# exchange (no trailing slash). loco dev default: 5150.
AUTH_API_URL=http://localhost:5150

# Not read by the app itself. Only `bin/e2e` / `playwright.config.ts`
# (the live-integration Playwright suite) read PUBLIC_API_BASE_URL, to
# call the service directly for test setup/cleanup and to point the
# built preview's webServer at it. Default there: http://localhost:8080
# (the podman-compose production container's exposed port).
# PUBLIC_API_BASE_URL=http://localhost:8080
