{% extends "layout.html.tera" %}

{% block title %}Review queue (kanban) &mdash; {{ entity_plural | capitalize }} &mdash; {{ app_display }}{% endblock title %}

{% block content %}
<nav class="breadcrumb-nav" aria-label="Breadcrumb">
  <ol class="breadcrumb-list" aria-label="Breadcrumb trail">
    <li class="breadcrumb-list-item"><a href="/">Home</a></li>
    <li class="breadcrumb-list-item"><a href="/{{ entity_plural }}">{{ entity_plural | capitalize }}</a></li>
    <li class="breadcrumb-list-item"><a href="/{{ entity_plural }}/review-queue">Review queue</a></li>
    <li class="breadcrumb-list-item" aria-current="page">Kanban</li>
  </ol>
</nav>

<section aria-label="Duplicate review queue (kanban view)"
         x-data='{
           items: {{ items | json_encode | safe }},
           dragId: null,
           startDrag(id) {
             this.dragId = id;
           },
           drop(status) {
             if (!this.dragId) return;
             var dragged = this.items.find(it => it.id === this.dragId) || null;
             var prev = dragged ? dragged.status : null;
             this.items = this.items.map(function (it) {
               return it.id === this.dragId ? Object.assign({}, it, { status: status }) : it;
             }, this);
             if (window.lily &amp;&amp; window.lily.toast &amp;&amp; dragged &amp;&amp; prev !== status) {
               window.lily.toast(dragged.id + ": " + prev + " → " + status, "info");
             }
             this.dragId = null;
           },
           byStatus(status) {
             return this.items.filter(function (it) { return it.status === status; });
           }
         }'>
  <h2>Review queue &mdash; kanban</h2>

  <div class="information-callout" aria-label="Kanban explainer">
    <p>
      Drag a card between columns to change its review status. The status
      change posts to <code>POST /api/{{ entity_plural }}/review-queue/{id}/status</code>
      (the toast confirms the transition). The classic
      <a href="/{{ entity_plural }}/review-queue">table view</a> is a row-per-item
      alternative.
    </p>
  </div>

  <div class="action-bar" role="toolbar" aria-label="Kanban controls">
    <span class="action-bar-count">{{ items | length }} item{% if items | length != 1 %}s{% endif %}</span>
    <a class="button"
       href="/{{ entity_plural }}/review-queue"
       aria-label="Switch to table view">Switch to table view</a>
  </div>

  <table class="kanban-table" aria-label="Review queue kanban board">
    <thead class="kanban-table-head">
      <tr class="kanban-table-row">
        {% for col in columns %}
          <th class="kanban-table-th" scope="col">
            {% if col.status == "Pending" %}
              <span class="badge" data-type="info" aria-label="Column: Pending">Pending</span>
            {% elif col.status == "Confirmed" %}
              <span class="badge" data-type="success" aria-label="Column: Confirmed">Confirmed</span>
            {% elif col.status == "Rejected" %}
              <span class="badge" data-type="error" aria-label="Column: Rejected">Rejected</span>
            {% elif col.status == "AutoMerged" %}
              <span class="badge" data-type="warning" aria-label="Column: AutoMerged">AutoMerged</span>
            {% endif %}
            <span class="hint" aria-label="Column count">
              (<span x-text="byStatus('{{ col.status }}').length"></span>)
            </span>
          </th>
        {% endfor %}
      </tr>
    </thead>
    <tbody class="kanban-table-body">
      <tr class="kanban-table-row">
        {% for col in columns %}
          <td class="kanban-table-td"
              aria-label="{{ col.status }} column dropzone"
              @dragover.prevent
              @drop.prevent="drop('{{ col.status }}')">
            <template x-for="item in byStatus('{{ col.status }}')" :key="item.id">
              <article class="card"
                       role="region"
                       draggable="true"
                       x-bind:aria-label="'Card: ' + item.a_label + ' vs ' + item.b_label"
                       x-bind:aria-grabbed="dragId === item.id ? 'true' : 'false'"
                       @dragstart="startDrag(item.id); $event.dataTransfer.effectAllowed = 'move'"
                       style="cursor: grab;">
                <header>
                  <strong>
                    <a x-bind:href="'/{{ entity_plural }}/' + item.a_id"
                       x-text="item.a_label"
                       x-bind:aria-label="'Open ' + item.a_label"></a>
                  </strong>
                  <span class="hint">vs.</span>
                  <strong>
                    <a x-bind:href="'/{{ entity_plural }}/' + item.b_id"
                       x-text="item.b_label"
                       x-bind:aria-label="'Open ' + item.b_label"></a>
                  </strong>
                </header>
                <p>
                  <strong x-text="item.score"></strong>
                  <template x-if="item.quality === 'definite'">
                    <span class="badge" data-type="success" aria-label="Definite match">Definite</span>
                  </template>
                  <template x-if="item.quality === 'probable'">
                    <span class="badge" data-type="warning" aria-label="Probable match">Probable</span>
                  </template>
                  <template x-if="item.quality === 'possible'">
                    <span class="badge" data-type="info" aria-label="Possible match">Possible</span>
                  </template>
                  <template x-if="item.quality === 'unlikely'">
                    <span class="badge" data-type="error" aria-label="Unlikely match">Unlikely</span>
                  </template>
                </p>
                <p>
                  <span class="hint" x-text="item.detection_method"></span>
                </p>
                <div class="action-bar" role="toolbar" aria-label="Card actions">
                  <a class="button"
                     x-bind:href="'/{{ entity_plural }}/compare?a=' + item.a_id + '&amp;b=' + item.b_id + '&amp;review_id=' + item.id"
                     aria-label="Open side-by-side comparison">Compare</a>
                </div>
              </article>
            </template>
            <p x-show="byStatus('{{ col.status }}').length === 0">
              <span class="hint" aria-label="Empty column">No items.</span>
            </p>
          </td>
        {% endfor %}
      </tr>
    </tbody>
  </table>
</section>
{% endblock content %}
