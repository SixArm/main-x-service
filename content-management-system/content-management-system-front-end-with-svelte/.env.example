# Content Management System Service base URL (no trailing slash).
# Server-side only — read by src/lib/server/config.ts and never reaches
# the browser bundle. 5150 is the loco.rs default port the service binds
# in dev.
CMS_API_URL=http://localhost:5150

# Authentication Service base URL (no trailing slash). Server-side only.
# Used for the session -> PASETO exchange and the magic-link
# request/verify flow (/signin, /verify).
AUTH_API_URL=http://localhost:5150

# Shows the "Sign in with SSO" link on /signin and enables the /signin/sso
# redirect route (EV-2, agents/share/authentication-sessions.md §7a). A plain
# boolean flag. Set ONLY when the paired auth-service has its AUTH_OIDC_*
# variables configured; unset (the default) hides the link entirely.
# PUBLIC_OIDC_SIGNIN_ENABLED=true
