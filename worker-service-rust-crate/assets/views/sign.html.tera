{% extends "layout.html.tera" %}

{% block title %}Sign &mdash; {{ record.label }} &mdash; {{ app_display }}{% endblock title %}

{% block content %}
<nav class="breadcrumb-nav" aria-label="Breadcrumb">
  <ol class="breadcrumb-list" aria-label="Breadcrumb trail">
    <li class="breadcrumb-list-item"><a href="/">Home</a></li>
    <li class="breadcrumb-list-item"><a href="/{{ entity_plural }}">{{ entity_plural | capitalize }}</a></li>
    <li class="breadcrumb-list-item"><a href="/{{ entity_plural }}/{{ record.id }}">{{ record.label }}</a></li>
    <li class="breadcrumb-list-item" aria-current="page">Sign</li>
  </ol>
</nav>

<section aria-label="Capture signature"
         x-data='{
           purpose: "{{ purpose }}",
           signedByName: "",
           signedAt: new Date().toISOString().slice(0, 16),
           acknowledged: false,
           strokes: [],
           current: null,
           canvas: null,
           ctx: null,
           dpr: 1,
           dataUrl: null,
           saved: false,
           init(canvas) {
             this.canvas = canvas;
             this.ctx = canvas.getContext("2d");
             this.dpr = window.devicePixelRatio || 1;
             this.resize();
             window.addEventListener("resize", () => this.resize());
           },
           resize() {
             var rect = this.canvas.getBoundingClientRect();
             this.canvas.width = rect.width * this.dpr;
             this.canvas.height = rect.height * this.dpr;
             this.ctx.scale(this.dpr, this.dpr);
             this.ctx.lineCap = "round";
             this.ctx.lineJoin = "round";
             this.ctx.lineWidth = 2;
             this.ctx.strokeStyle = "#212b32";
             this.redraw();
           },
           pointPos(evt) {
             var rect = this.canvas.getBoundingClientRect();
             return { x: evt.clientX - rect.left, y: evt.clientY - rect.top };
           },
           onDown(evt) {
             evt.preventDefault();
             this.canvas.setPointerCapture(evt.pointerId);
             var p = this.pointPos(evt);
             this.current = [p];
           },
           onMove(evt) {
             if (!this.current) return;
             var p = this.pointPos(evt);
             var prev = this.current[this.current.length - 1];
             this.current.push(p);
             this.ctx.beginPath();
             this.ctx.moveTo(prev.x, prev.y);
             this.ctx.lineTo(p.x, p.y);
             this.ctx.stroke();
           },
           onUp(evt) {
             if (!this.current) return;
             if (this.current.length > 1) this.strokes.push(this.current);
             this.current = null;
           },
           clear() {
             this.strokes = [];
             this.current = null;
             this.dataUrl = null;
             this.saved = false;
             this.redraw();
             window.lily.toast("Signature cleared", "info");
           },
           undo() {
             this.strokes.pop();
             this.redraw();
           },
           redraw() {
             var rect = this.canvas.getBoundingClientRect();
             this.ctx.clearRect(0, 0, rect.width, rect.height);
             for (var s of this.strokes) {
               if (s.length < 2) continue;
               this.ctx.beginPath();
               this.ctx.moveTo(s[0].x, s[0].y);
               for (var i = 1; i < s.length; i++) this.ctx.lineTo(s[i].x, s[i].y);
               this.ctx.stroke();
             }
           },
           hasSignature() { return this.strokes.length > 0; },
           canSubmit() { return this.hasSignature() &amp;&amp; this.signedByName.length > 0 &amp;&amp; this.acknowledged; },
           submit() {
             if (!this.canSubmit()) {
               window.lily.toast("Provide name, signature, and acknowledgement", "error");
               return;
             }
             this.dataUrl = this.canvas.toDataURL("image/png");
             this.saved = true;
             window.lily.toast("Signature captured for {{ record.label }}", "success");
           }
         }'>
  <h2>Capture signature &mdash; {{ record.label }}</h2>

  <div class="information-callout" aria-label="Signature workflow guidance">
    <p>
      This page captures a typed name + drawn signature + acknowledgement
      and pairs them with the {{ entity_singular }} record above. Production
      should POST the canvas PNG (base64) along with the typed name +
      ISO-8601 timestamp + purpose + IP + user-agent to
      <code>POST /api/{{ entity_plural }}/{{ record.id }}/signatures</code>
      and store the result on the audit trail. The signature is rendered
      device-pixel-ratio-aware so high-DPI screens get crisp strokes.
    </p>
  </div>

  <form class="form" aria-label="Signature capture form" @submit.prevent="submit()">
    <fieldset class="fieldset" aria-label="Signature context">
      <legend>Context</legend>

      <div class="field" aria-label="Purpose field" data-required>
        <label class="label" for="purpose">Purpose</label>
        <span class="hint" id="purpose-hint">What is being signed for?</span>
        <select class="select"
                id="purpose"
                name="purpose"
                aria-label="Signature purpose"
                aria-describedby="purpose-hint"
                x-model="purpose">
          <option class="option" value="consent">Consent (GDPR / data processing)</option>
          <option class="option" value="witness">Witness statement</option>
          <option class="option" value="acknowledgement">Acknowledgement of receipt</option>
          <option class="option" value="authorisation">Authorisation / approval</option>
          <option class="option" value="other">Other</option>
        </select>
      </div>

      <div class="field" aria-label="Signed-by name field" data-required>
        <label class="label" for="signed-by-name">Signed by</label>
        <span class="hint" id="signed-by-name-hint">Full legal name as you would write it on a paper form.</span>
        <input class="text-input"
               type="text"
               id="signed-by-name"
               name="signed_by_name"
               required
               autocomplete="name"
               aria-label="Signed-by name"
               aria-describedby="signed-by-name-hint"
               x-model="signedByName">
      </div>

      <div class="field" aria-label="Signed-at field">
        <label class="label" for="signed-at">Signed at</label>
        <span class="hint" id="signed-at-hint">Defaults to now; adjustable for back-dated signatures.</span>
        <input class="text-input"
               type="datetime-local"
               id="signed-at"
               name="signed_at"
               aria-label="Signed at"
               aria-describedby="signed-at-hint"
               x-model="signedAt">
      </div>
    </fieldset>

    <fieldset class="fieldset" aria-label="Signature pad">
      <legend>Signature</legend>
      <span class="hint">
        Draw with a finger, pen, or mouse. Strokes are kept as
        per-segment paths so <strong>Undo</strong> removes one
        stroke at a time. <strong>Clear</strong> resets the canvas.
      </span>
      <div class="signature-pad"
           aria-label="Signature drawing area"
           x-bind:data-state="hasSignature() ? 'drawn' : 'empty'">
        <canvas class="signature-pad-canvas"
                aria-label="Signature canvas"
                role="img"
                x-ref="canvas"
                x-init="init($refs.canvas)"
                @pointerdown="onDown($event)"
                @pointermove="onMove($event)"
                @pointerup="onUp($event)"
                @pointerleave="onUp($event)"
                @pointercancel="onUp($event)"
                style="touch-action: none;"></canvas>
        <div class="signature-pad-baseline" aria-hidden="true"></div>
        <span class="signature-pad-placeholder"
              aria-hidden="true"
              x-show="!hasSignature()">Sign here</span>
      </div>
      <div class="action-bar signature-pad-toolbar" role="toolbar" aria-label="Signature actions">
        <button class="action-bar-button"
                type="button"
                aria-label="Undo last stroke"
                x-bind:disabled="!hasSignature()"
                @click="undo()">Undo</button>
        <button class="action-bar-button"
                type="button"
                aria-label="Clear signature"
                x-bind:disabled="!hasSignature()"
                @click="clear()">Clear</button>
      </div>
    </fieldset>

    <div class="field" aria-label="Acknowledgement field" data-required>
      <label class="label" for="ack-check">
        <input class="checkbox-input"
               type="checkbox"
               id="ack-check"
               required
               aria-label="Acknowledge that this signature is genuine"
               x-model="acknowledged">
        I confirm this signature is mine and accurately reflects my
        intent. I understand a copy is recorded in the audit log.
      </label>
    </div>

    <div class="action-bar" role="toolbar" aria-label="Submit actions">
      <button class="button"
              type="submit"
              aria-label="Submit signature"
              x-bind:disabled="!canSubmit()">Submit signature</button>
      <a class="button"
         href="/{{ entity_plural }}/{{ record.id }}"
         aria-label="Cancel and return to {{ record.label }}">Cancel</a>
    </div>
  </form>

  <div class="alert"
       role="alert"
       data-type="success"
       aria-label="Signature accepted"
       x-show="saved"
       x-transition>
    <h3>Signature captured</h3>
    <p>
      Signed by <strong x-text="signedByName"></strong> as
      <strong x-text="purpose"></strong> at <strong x-text="signedAt"></strong>.
      The PNG below is what would POST to the API
      (truncated for display).
    </p>
    <details class="details" aria-label="Captured PNG data URL preview">
      <summary>Show captured PNG (base64)</summary>
      <pre class="code-block" aria-label="Truncated PNG data URL"><code x-text="dataUrl &amp;&amp; (dataUrl.slice(0, 96) + '...' + dataUrl.slice(-32))"></code></pre>
    </details>
  </div>
</section>
{% endblock content %}
