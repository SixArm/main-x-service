{
  "name": "@lilydesignsystem/svelte-theme-picker",
  "version": "0.1.2",
  "engines": {
    "node": "=26"
  },
  "description": "Lily Design System Svelte 5 theme picker: an icon button opening an APG listbox that swaps a theme stylesheet and sets data-theme. Headless, SSR-safe, no CSS.",
  "type": "module",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "index.md",
    "README.md"
  ],
  "scripts": {
    "prepublishOnly": "cd .. && npm run build"
  },
  "dependencies": {
    "@lilydesignsystem/svelte-headless": "^0.2.0"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "keywords": [
    "lily",
    "design",
    "system",
    "svelte",
    "theme",
    "picker"
  ],
  "author": "Joel Parker Henderson <joel@joelparkerhenderson.com>",
  "license": "MIT OR Apache-2.0 OR GPL-2.0-only OR GPL-3.0-only OR BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LilyDesignSystem/lily-design-system-svelte-helpers.git",
    "directory": "lily-design-system-svelte-theme-picker"
  },
  "homepage": "https://lilydesignsystem.com/",
  "bugs": {
    "url": "https://github.com/LilyDesignSystem/lily-design-system/issues"
  },
  "devDependencies": {
    "@sveltejs/kit": "^2.70.3"
  }
}
