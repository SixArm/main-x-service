{
  "name": "@lilydesignsystem/svelte-headless",
  "version": "0.1.0",
  "engines": {
    "node": "=26"
  },
  "description": "A comprehensive headless Svelte 5 component library with 491 accessible, unstyled components for building design systems. Targets WCAG 2.2 AAA.",
  "scripts": {
    "build": "node build.mjs",
    "prepublishOnly": "node build.mjs",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LilyDesignSystem/lily-design-system-svelte-headless.git"
  },
  "keywords": [
    "lily",
    "design",
    "system",
    "headless",
    "svelte",
    "components",
    "accessibility",
    "wcag"
  ],
  "author": "Joel Parker Henderson <joel@joelparkerhenderson.com>",
  "license": "MIT OR Apache-2.0 OR GPL-2.0-only OR GPL-3.0-only OR BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/LilyDesignSystem/lily-design-system/issues"
  },
  "homepage": "https://lilydesignsystem.com/",
  "devDependencies": {
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.7",
    "@vitest/ui": "^4.1.11",
    "jsdom": "^30.0.1",
    "svelte": "^5.57.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "aria-query": "^5.3.2"
  },
  "type": "module",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "index.md",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "svelte": "^5.0.0"
  }
}
