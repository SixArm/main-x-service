{% extends "layout.html.tera" %}

{% block title %}Notifications &mdash; {{ app_display }}{% endblock title %}

{% block content %}
<nav class="breadcrumb-nav" aria-label="Breadcrumb">
  <ol class="breadcrumb-list" aria-label="Breadcrumb trail">
    <li class="breadcrumb-list-item"><a href="/">Home</a></li>
    <li class="breadcrumb-list-item" aria-current="page">Notifications</li>
  </ol>
</nav>

<section aria-label="Notification center"
         x-data='{
           items: {{ notifications | json_encode | safe }},
           filter: "all",
           visible(n) {
             if (this.filter === "all") return true;
             if (this.filter === "unread") return n.unread;
             return n.severity === this.filter;
           },
           unreadCount() {
             return this.items.filter(function (n) { return n.unread; }).length;
           },
           markRead(id) {
             this.items = this.items.map(function (n) {
               if (n.id === id) n.unread = false;
               return n;
             });
             this.persist();
           },
           markAllRead() {
             this.items = this.items.map(function (n) { n.unread = false; return n; });
             this.persist();
             if (window.lily &amp;&amp; window.lily.toast) {
               window.lily.toast("All notifications marked as read", "info");
             }
           },
           dismiss(id) {
             this.items = this.items.filter(function (n) { return n.id !== id; });
             this.persist();
             if (window.lily &amp;&amp; window.lily.toast) {
               window.lily.toast("Notification dismissed", "info");
             }
           },
           persist() {
             try { localStorage.setItem("lily-notifications", JSON.stringify(this.items)); }
             catch (e) { /* ignore */ }
           },
           init() {
             try {
               var stored = localStorage.getItem("lily-notifications");
               if (stored) this.items = JSON.parse(stored);
             } catch (e) { /* ignore */ }
           }
         }'
         x-init="init()">
  <h2>Notification center</h2>

  <div class="information-callout" aria-label="Notification explainer">
    <p>
      Persistent archive of system events &mdash; deletions, merges, validation
      failures, scheduled-job results. Toast notifications (the bottom-right
      pop-ups) are ephemeral; this page is the durable history. State persists
      in <code>localStorage["lily-notifications"]</code>.
    </p>
  </div>

  <div class="action-bar" role="toolbar" aria-label="Notification controls">
    <span class="action-bar-count">
      <span x-text="unreadCount()"></span> unread
      &middot;
      <span x-text="items.length"></span> total
    </span>
    <button class="button"
            type="button"
            aria-label="Mark all as read"
            x-bind:disabled="unreadCount() === 0"
            @click="markAllRead()">Mark all read</button>
    <a class="button" href="/audit" aria-label="Open system audit log">System audit</a>
  </div>

  <div class="segment-group" role="group" aria-label="Severity filter">
    {% for f in filters %}
      <button class="segment-group-item"
              type="button"
              aria-label="Filter: {{ f.label }}"
              x-bind:aria-pressed="filter === '{{ f.value }}' ? 'true' : 'false'"
              @click="filter = '{{ f.value }}'">{{ f.label }}</button>
    {% endfor %}
  </div>

  <ol class="summary-list" aria-label="Notification list">
    <template x-for="n in items.filter(item => visible(item))" :key="n.id">
      <li class="summary-list-item">
        <article class="notification"
                 role="alert"
                 x-bind:data-severity="n.severity"
                 x-bind:data-unread="n.unread ? 'true' : 'false'"
                 x-bind:aria-label="(n.unread ? 'Unread' : 'Read') + ' notification: ' + n.title">
          <header>
            <strong x-text="n.title"></strong>
            <template x-if="n.severity === 'success'">
              <span class="badge" data-type="success" aria-label="Severity: success">Success</span>
            </template>
            <template x-if="n.severity === 'info'">
              <span class="badge" data-type="info" aria-label="Severity: info">Info</span>
            </template>
            <template x-if="n.severity === 'warning'">
              <span class="badge" data-type="warning" aria-label="Severity: warning">Warning</span>
            </template>
            <template x-if="n.severity === 'error'">
              <span class="badge" data-type="error" aria-label="Severity: error">Error</span>
            </template>
            &middot;
            <time x-bind:datetime="n.at" x-text="n.at"></time>
          </header>
          <p x-text="n.body"></p>
          <div class="action-bar" role="toolbar" aria-label="Notification actions">
            <template x-if="n.href">
              <a class="button"
                 x-bind:href="n.href"
                 x-bind:aria-label="'Open source: ' + n.href"
                 @click="markRead(n.id)">Open source</a>
            </template>
            <button class="action-bar-button"
                    type="button"
                    x-bind:aria-label="'Mark as read: ' + n.title"
                    x-show="n.unread"
                    @click="markRead(n.id)">Mark read</button>
            <button class="action-bar-button"
                    type="button"
                    x-bind:aria-label="'Dismiss: ' + n.title"
                    @click="dismiss(n.id)">Dismiss</button>
          </div>
        </article>
      </li>
    </template>
    <li x-show="items.filter(item => visible(item)).length === 0">
      <div class="alert" role="alert" aria-label="Empty notification list" data-type="info">
        No notifications match the current filter.
      </div>
    </li>
  </ol>
</section>
{% endblock content %}
