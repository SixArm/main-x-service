{
  "name": "Main X Index (main-x-service)",
  "summary": "A federated identity index: ~55 self-contained Rust crates (loco.rs backend services + SvelteKit operator front-ends), one per real-world entity (person, worker, place, thing, event, course, organization, care pathway, case, plan/portfolio), each doing CRUD, probabilistic + deterministic matching, full-text search, record merge, an audit trail, and event streaming \u2014 plus a central SSO provider, a cross-service link-graph aggregator, and five consumer applications that build on the registries.",
  "notes": "Each crate is self-contained (own REST API, own persistence, own matching algorithm) and shares an architecture and documentation layout, not code. Every subproject's spec/ directory is the single source of truth for that subproject; code conforms to the spec, not the reverse. This file describes the published documentation site (main-x-service.github.io), a curated front door \u2014 not the git checkout; every entry links to its GitHub source since the site itself renders only a handful of overview pages (see \"This site\" below).",
  "repository": [
    "https://github.com/SixArm/main-x-service",
    "https://codeberg.org/SixArm/main-x-service"
  ],
  "license": {
    "rust_crates": "MIT OR Apache-2.0 OR BSD-3-Clause OR GPL-2.0-only OR GPL-3.0-only",
    "front_ends": "MIT OR Apache-2.0",
    "doc": "LICENSE.md"
  },
