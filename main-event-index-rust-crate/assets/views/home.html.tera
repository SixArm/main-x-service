{% extends "layout.html.tera" %}

{% block title %}{{ app_display }} &mdash; Home{% endblock title %}

{% block content %}
<section class="hero" aria-label="Welcome">
  <h2>Welcome to the {{ app_display }}</h2>
  <p>A {{ entity_singular }} identity registry powered by Loco, Tera, HTMX, Alpine, and the Lily Design System.</p>
</section>

<section aria-label="Quick search" x-data="{ query: '' }">
  <h3>Quick search</h3>
  <form class="form"
        aria-label="Quick {{ entity_singular }} search"
        hx-get="/{{ entity_plural }}/search/partial"
        hx-target="#search-results"
        hx-trigger="input changed delay:300ms from:input, submit"
        hx-swap="innerHTML">
    <div class="field" aria-label="Search query field">
      <label class="label" for="q">Search {{ entity_plural }}</label>
      <span class="hint" id="q-hint">Start typing to search.</span>
      <input class="search-input"
             role="searchbox"
             type="search"
             id="q"
             name="q"
             aria-label="Search {{ entity_plural }}"
             aria-describedby="q-hint"
             autocomplete="off"
             x-model="query"
             placeholder="Start typing to search&hellip;">
    </div>
    <button class="button" type="submit" aria-label="Run search">Search</button>
    <p x-show="query.length > 0" x-transition>
      Searching for <strong x-text="query"></strong>&hellip;
    </p>
  </form>

  <div id="search-results" aria-live="polite" aria-busy="false"></div>
</section>

<section aria-label="What's inside">
  <h3>What's inside</h3>
  <div class="diff" role="group" aria-label="Mockup previews of the {{ app_display }}">
    <article class="card" role="region" aria-label="Web UI preview">
      <h4>Web UI</h4>
      <div class="mockup-browser" aria-label="Mockup of the browser UI">
        <div>
          <p><strong>{{ entity_plural | capitalize }}</strong></p>
          <ul>
            <li><a href="/{{ entity_plural }}">Browse</a> &middot; data-table with bulk-select</li>
            <li><a href="/{{ entity_plural }}/search">Search</a> &middot; filter drawer + sparkline</li>
            <li><a href="/{{ entity_plural }}/review-queue">Review queue</a> &middot; alert-dialog merge</li>
          </ul>
        </div>
      </div>
      <p>
        <span class="hint" aria-label="Web UI hint">
          Server-rendered Tera + HTMX + Alpine. Theme-able and keyboard-driven.
        </span>
      </p>
    </article>

    <article class="card" role="region" aria-label="REST API preview">
      <h4>REST &amp; FHIR APIs</h4>
      <div class="mockup-shell" aria-label="Mockup of a curl call to the JSON API">curl http://localhost:8080/api/{{ entity_plural }}/search?q=smith</div>
      <div class="mockup-shell" aria-label="Mockup of a curl call to the FHIR API">curl http://localhost:8080/fhir/Person/abc-123 \
  -H 'Accept: application/fhir+json'</div>
      <p>
        <span class="hint" aria-label="REST API hint">
          OpenAPI 3.0 spec + Swagger UI at <code>/swagger-ui</code>; FHIR R5 at <code>/fhir/*</code>.
        </span>
      </p>
    </article>

    <article class="card" role="region" aria-label="Mobile preview">
      <h4>Mobile-ready</h4>
      <div class="mockup-phone-portrait" aria-label="Mockup of the mobile responsive layout">
        <p><strong>{{ app_display }}</strong></p>
        <p>
          <span class="hint">Headless components stay readable at 320 px width; filter drawer adapts to full-screen.</span>
        </p>
        <p>
          <a class="action-link" href="/{{ entity_plural }}">Open {{ entity_plural }} &rarr;</a>
        </p>
      </div>
    </article>
  </div>
</section>

<section aria-label="API endpoints">
  <h3>API endpoints</h3>
  <ul>
    <li><a href="/{{ entity_plural }}">Browse {{ entity_plural }}</a></li>
    <li><a href="/{{ entity_plural }}/import">Bulk import (CSV)</a></li>
    <li><a href="/api/health">Health check</a></li>
    <li><a href="/api/{{ entity_plural }}">JSON API</a></li>
    <li><a href="/tour">Guided tour</a></li>
  </ul>
</section>
{% endblock content %}
