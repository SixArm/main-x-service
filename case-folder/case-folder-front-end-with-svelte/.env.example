# Shows the "Sign in with SSO" link on /login and enables the /login/sso
# redirect route (EV-2, agents/share/authentication-sessions.md §7a).
# A plain boolean flag. Set it ONLY when the paired auth-service has its
# own AUTH_OIDC_* variables configured; unset (the default) hides the
# link, and magic link stays the default sign-in path.
# PUBLIC_OIDC_SIGNIN_ENABLED=true

# Auth service base URL used for the SSO redirect (server-only).
# Defaults to LOCO_API_PROXY, then http://localhost:5150.
# AUTH_API_URL=http://localhost:5150
