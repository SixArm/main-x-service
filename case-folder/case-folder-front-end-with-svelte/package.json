{
    "name": "case-folder",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "Case Tracking for paper medical records in NHS hospital settings. Tracks paper folders by NHS Number across physical file cabinets.",
    "scripts": {
        "dev": "vite dev",
        "build": "vite build",
        "preview": "vite preview",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "test:e2e:headed": "playwright test --headed",
        "test:unit": "vitest run",
        "lint": "eslint .",
        "gen:api": "openapi-typescript ../case-folder-service-with-rust/openapi.yaml -o src/lib/api/schema.d.ts"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.11.3",
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.60.0",
        "@sveltejs/adapter-auto": "^4.0.0",
        "@sveltejs/kit": "^2.55.0",
        "@sveltejs/vite-plugin-svelte": "^5.0.0",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/svelte": "^5.3.1",
        "axe-core": "^4.12.1",
        "eslint": "^10.4.1",
        "eslint-plugin-svelte": "^3.19.0",
        "globals": "^17.6.0",
        "jsdom": "^29.1.1",
        "openapi-typescript": "^7.13.0",
        "svelte": "^5.25.0",
        "svelte-check": "^4.2.0",
        "svelte-eslint-parser": "^1.8.0",
        "typescript": "^5.8.0",
        "typescript-eslint": "^8.61.0",
        "vite": "^6.2.0",
        "vitest": "^4.1.8"
    },
    "dependencies": {
        "@fortawesome/fontawesome-svg-core": "^7.2.0",
        "@fortawesome/free-solid-svg-icons": "^7.2.0",
        "wx-svelte-core": "^2.1.0",
        "wx-svelte-grid": "^2.1.0"
    }
}
