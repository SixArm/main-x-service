{
  "name": "case-folder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "=26"
  },
  "description": "Case Tracking for paper medical records in NHS hospital settings. Tracks paper folders by NHS Number across physical file cabinets.",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:unit": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "gen:api": "openapi-typescript ../case-folder-service-with-rust/openapi.yaml -o src/lib/api/schema.d.ts && prettier --write src/lib/api/schema.d.ts",
    "verify:api": "npm run gen:api && git diff --exit-code -- src/lib/api/schema.d.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@sveltejs/adapter-auto": "^4.0.0",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^26.6.2",
    "axe-core": "^4.13.0",
    "eslint": "^10.10.0",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.8",
    "prettier-plugin-svelte": "^3.3.0",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "svelte-eslint-parser": "^1.8.1",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.2.0",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@svar-ui/svelte-calendar": "^2.7.1",
    "@svar-ui/svelte-filemanager": "^2.6.0",
    "@svar-ui/svelte-filter": "^2.6.1",
    "@svar-ui/svelte-gantt": "^2.7.3",
    "@svar-ui/svelte-grid": "^2.7.3",
    "@svar-ui/svelte-kanban": "^2.6.0",
    "@lilydesignsystem/svelte-headless": "^0.1.0",
    "@lilydesignsystem/svelte-locale-picker": "^0.1.0",
    "@lilydesignsystem/svelte-picker-bar": "^0.1.0",
    "@lilydesignsystem/svelte-share-picker": "^0.1.0",
    "@lilydesignsystem/svelte-text-size-picker": "^0.1.0",
    "@lilydesignsystem/svelte-theme-picker": "^0.1.0"
  }
}
