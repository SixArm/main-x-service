{% extends "layout.html.tera" %}

{% block title %}Recent audit activity &mdash; {{ app_display }}{% endblock title %}

{% block content %}
<nav class="breadcrumb-nav" aria-label="Breadcrumb">
  <ol class="breadcrumb-list" aria-label="Breadcrumb trail">
    <li class="breadcrumb-list-item"><a href="/">Home</a></li>
    <li class="breadcrumb-list-item" aria-current="page">Audit</li>
  </ol>
</nav>

<section aria-label="Recent audit activity">
  <h2>Recent audit activity</h2>
  <p>
    <span class="hint" aria-label="System audit description">
      System-wide HIPAA audit trail. Showing the most recent
      {{ entries | length }} event{% if entries | length != 1 %}s{% endif %}.
    </span>
  </p>

  <form class="form"
        aria-label="Filter system audit"
        method="get"
        action="/audit"
        hx-get="/audit"
        hx-target="#audit-timeline"
        hx-select="#audit-timeline"
        hx-swap="outerHTML"
        hx-trigger="change">
    <div class="field" aria-label="Action filter field">
      <label class="label" for="action-filter">Action</label>
      <select class="select"
              id="action-filter"
              name="action"
              aria-label="Filter by action">
        <option class="option" value="">All actions</option>
        <option class="option" value="Created" {% if filter_action == "Created" %}selected{% endif %}>Created</option>
        <option class="option" value="Updated" {% if filter_action == "Updated" %}selected{% endif %}>Updated</option>
        <option class="option" value="Deleted" {% if filter_action == "Deleted" %}selected{% endif %}>Deleted</option>
        <option class="option" value="Merged" {% if filter_action == "Merged" %}selected{% endif %}>Merged</option>
        <option class="option" value="Linked" {% if filter_action == "Linked" %}selected{% endif %}>Linked</option>
      </select>
    </div>

    <div class="field" aria-label="User filter field">
      <label class="label" for="user-filter">User</label>
      <span class="hint" id="user-filter-hint">Filter by user identifier (exact match).</span>
      <input class="text-input"
             type="text"
             id="user-filter"
             name="user_id"
             value="{{ filter_user | default(value='') }}"
             aria-label="Filter by user"
             aria-describedby="user-filter-hint"
             placeholder="u-alice">
    </div>

    <div class="field" aria-label="Limit field">
      <label class="label" for="limit">Limit</label>
      <select class="select"
              id="limit"
              name="limit"
              aria-label="Number of entries to show">
        <option class="option" value="25" {% if filter_limit == 25 %}selected{% endif %}>25</option>
        <option class="option" value="50" {% if filter_limit == 50 %}selected{% endif %}>50</option>
        <option class="option" value="100" {% if filter_limit == 100 %}selected{% endif %}>100</option>
        <option class="option" value="500" {% if filter_limit == 500 %}selected{% endif %}>500</option>
      </select>
    </div>
  </form>

  {% if active_filters and active_filters | length > 0 %}
    <div class="tag-group" aria-label="Active filters">
      {% for f in active_filters %}
        <span class="tag" aria-label="Active filter: {{ f }}">{{ f }}</span>
      {% endfor %}
    </div>
  {% endif %}

  {% if entries | length == 0 %}
    <div class="alert" role="alert" aria-label="Empty audit log" data-type="info">
      No audit events match the current filter.
    </div>
  {% else %}
    <ol class="timeline-list" id="audit-timeline" aria-label="System audit events, newest first">
      {% for entry in entries %}
        <li class="timeline-list-item">
          <header>
            {% if entry.action == "Created" %}
              <span class="badge" data-type="success" aria-label="Action: Created">Created</span>
            {% elif entry.action == "Updated" %}
              <span class="badge" data-type="info" aria-label="Action: Updated">Updated</span>
            {% elif entry.action == "Deleted" %}
              <span class="badge" data-type="error" aria-label="Action: Deleted">Deleted</span>
            {% elif entry.action == "Merged" %}
              <span class="badge" data-type="warning" aria-label="Action: Merged">Merged</span>
            {% else %}
              <span class="badge" aria-label="Action: {{ entry.action }}">{{ entry.action }}</span>
            {% endif %}
            <time datetime="{{ entry.at }}">{{ entry.at }}</time>
            {% if entry.entity_id %}
              &mdash;
              <a href="/{{ entity_plural }}/{{ entry.entity_id }}/audit"
                 aria-label="View per-record audit for {{ entry.entity_label }}">
                {{ entry.entity_label }}
              </a>
            {% endif %}
          </header>
          <ol class="summary-list" aria-label="Event details">
            <li class="summary-list-item">
              <dl>
                <dt>User</dt>
                <dd>
                  <code>{{ entry.user_id | default(value="system") }}</code>
                  {% if entry.user_ip %}
                    <span class="hint" aria-label="User IP address">from {{ entry.user_ip }}</span>
                  {% endif %}
                </dd>
              </dl>
            </li>
            {% if entry.summary %}
              <li class="summary-list-item">
                <dl>
                  <dt>Summary</dt>
                  <dd>{{ entry.summary }}</dd>
                </dl>
              </li>
            {% endif %}
          </ol>
        </li>
      {% endfor %}
    </ol>
  {% endif %}
</section>
{% endblock content %}
