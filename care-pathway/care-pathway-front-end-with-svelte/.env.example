# Care Pathway Front-End — environment example.
# Copy to `.env` (`cp .env.example .env`) and adjust per deployment.

# Base URL of the care-pathway service REST API (loco.rs dev default :5150).
PUBLIC_API_BASE_URL=http://localhost:5150

# Base URL of the central authentication (SSO) front-end. "Sign in"
# redirects to ${VITE_AUTH_FRONTEND_URL}/signin?return_to=… and the access
# token is handed back via the URL fragment (see agents/share/jwt-enforcement.md).
VITE_AUTH_FRONTEND_URL=http://localhost:5173
