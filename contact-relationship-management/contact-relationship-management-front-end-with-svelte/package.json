{
  "name": "contact-relationship-management-front-end-with-svelte",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SvelteKit front-end for the Contact Relationship Management Service (Main X Index): ward whiteboards, bed management, inpatient journey.",
  "license": "MIT OR Apache-2.0",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write src",
    "lint": "prettier --check src"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@sveltejs/adapter-auto": "^4.0.0",
    "@sveltejs/kit": "^2.55.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@testing-library/svelte": "^5.3.1",
    "@types/node": "^22.0.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.3.0",
    "prettier-plugin-svelte": "^3.3.0",
    "svelte": "^5.53.0",
    "svelte-check": "^4.2.0",
    "typescript": "^5.8.0",
    "vite": "^6.2.0",
    "vitest": "^3.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  },
  "dependencies": {
    "@svar-ui/svelte-filter": "^2.6.0",
    "@svar-ui/svelte-grid": "^2.7.1",
    "lily-design-system-svelte-headless": "file:../../../../lilydesignsystem/lily-design-system/lily-design-system-svelte-headless",
    "lily-design-system-svelte-locale-select": "file:../../../../lilydesignsystem/lily-design-system/lily-design-system-svelte-helpers/lily-design-system-svelte-locale-select",
    "lily-design-system-svelte-theme-select": "file:../../../../lilydesignsystem/lily-design-system/lily-design-system-svelte-helpers/lily-design-system-svelte-theme-select"
  }
}
