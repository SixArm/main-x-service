# Contact Relationship Management Service base URL (no trailing slash).
# Server-side only — read by src/lib/server/config.ts and never reaches
# the browser bundle. 5150 is the loco.rs default port the service binds
# in dev.
CRM_API_URL=http://localhost:5150

# Authentication Service base URL (no trailing slash). Server-side only.
# Used for the session -> PASETO exchange and the magic-link
# request/verify flow (/signin, /verify).
AUTH_API_URL=http://localhost:5150
